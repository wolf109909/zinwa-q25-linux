# SPDX-License-Identifier: GPL-2.0
# CachyOS + Arch Linux ARM Kernel Configuration Fragment for Zinwa Q25 (MediaTek Helio G99 MT6789)
# Merge with base config:
#   scripts/kconfig/merge_config.sh -m cachyos/config-mt6789-mainline-7.0.aarch64 cachyos/cachyos-mt6789.config

# --- CachyOS Scheduler & Responsiveness Tuning ---
CONFIG_SCHED_BORE=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y
CONFIG_ENERGY_MODEL=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPTION=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# --- Memory Management (MGLRU + ZSTD ZRAM) ---
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_COMPACTION=y
CONFIG_KSM=y

# --- Modern Arch Linux / systemd / Sandboxing / Containers ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_OVERLAY_FS=m
CONFIG_FUSE_FS=m

# --- Open-Source Mali-G57 GPU (Panfrost) & Display ---
CONFIG_DRM=y
CONFIG_DRM_PANFROST=m
CONFIG_DRM_MEDIATEK=m
CONFIG_DRM_MEDIATEK_DSI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=m
CONFIG_PWM_MEDIATEK=m
CONFIG_PWM_MTK_DISP=m

# --- Networking & BBRv3 ---
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=m
CONFIG_WIREGUARD=m
CONFIG_TUN=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y

# --- Peripherals Required by Zinwa Q25 Out-of-Tree Modules ---
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
CONFIG_GPIOLIB=y
CONFIG_GPIOLIB_LEGACY=y
CONFIG_OF_GPIO=y
CONFIG_PINCTRL_MT6789=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_LEDS_GPIO=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_MTK_PMIC=m
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6358=y
CONFIG_IIO=y
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_V4L2_FWNODE=m
CONFIG_NFC=m
CONFIG_NFC_NCI=m
CONFIG_SND=y
CONFIG_SND_SOC=y
