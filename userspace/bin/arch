#!/bin/bash
mountpoint -q /opt/arch/proc || sudo /usr/local/sbin/arch-mount
COMMON_ENV=(
  HOME=/root
  USER=root
  LOGNAME=root
  TERM="${TERM:-xterm-256color}"
  COLORTERM="${COLORTERM:-truecolor}"
  LANG=C.UTF-8
  PATH="/root/.local/bin:/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
  XDG_RUNTIME_DIR="/run/user/0"
  WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
  DISPLAY="${DISPLAY:-:0}"
  XDG_SESSION_TYPE=wayland
  XDG_CURRENT_DESKTOP="Phosh:GNOME"
  XDG_SESSION_DESKTOP=phosh
  EGL_PLATFORM=wayland
  GDK_GL=gles
  MOZ_ENABLE_WAYLAND=1
  QT_QPA_PLATFORM=wayland
)

if [ $# -eq 0 ]; then
  exec chroot /opt/arch /usr/bin/env -i "${COMMON_ENV[@]}" /usr/bin/fish -l
elif [ "$1" = "-c" ]; then
  exec chroot /opt/arch /usr/bin/env -i "${COMMON_ENV[@]}" /usr/bin/fish "$@"
else
  exec chroot /opt/arch /usr/bin/env -i "${COMMON_ENV[@]}" "$@"
fi
