#!/bin/sh
NODE="/sys/class/backlight/backlight/brightness"
MAX=$(cat /sys/class/backlight/backlight/max_brightness 2>/dev/null || echo 1023)
CUR=$(cat "$NODE" 2>/dev/null || echo 512)
STEP=$(( MAX / 10 ))
PCT=$(( (CUR * 100 + MAX / 2) / MAX ))

case "${1:-}" in
  "")
    echo "Brightness: ${PCT}% (${CUR}/${MAX})"
    exit 0
    ;;
  up|\+)
    NEW=$(( CUR + STEP ))
    ;;
  down|\-)
    NEW=$(( CUR - STEP ))
    ;;
  min|night)
    NEW=$(( MAX / 25 ))
    ;;
  max)
    NEW=$MAX
    ;;
  *)
    VAL="${1%%%}"
    NEW=$(( VAL * MAX / 100 ))
    ;;
esac

[ "$NEW" -lt 40 ] && NEW=40
[ "$NEW" -gt "$MAX" ] && NEW=$MAX
echo "$NEW" > "$NODE" 2>/dev/null || true
NEW_PCT=$(( (NEW * 100 + MAX / 2) / MAX ))
echo "Brightness: ${NEW_PCT}% (${NEW}/${MAX})"
