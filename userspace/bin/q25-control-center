#!/usr/bin/env python3
"""
Zinwa Q25 Hardware Control Center (GTK4 / Libadwaita)
Minimal, fast, touch & keyboard friendly hardware dashboard for Mainline Linux 7.3.3-cachyos-q25.
"""

import json
import os
import subprocess
import threading
import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Gdk, Adw, GLib


def read_sysfs_int(path, default=0):
    try:
        with open(path, "r") as f:
            return int(f.read().strip())
    except Exception:
        return default


def read_sysfs_str(path, default=""):
    try:
        with open(path, "r") as f:
            return f.read().strip()
    except Exception:
        return default


def write_sysfs(path, value):
    try:
        with open(path, "w") as f:
            f.write(f"{value}\n")
        return True
    except Exception as e:
        print(f"write_sysfs({path}, {value}) failed: {e}")
        return False


def run_cmd(cmd, timeout=15):
    try:
        r = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
        )
        return r.returncode == 0, (r.stdout or "").strip(), (r.stderr or "").strip()
    except Exception as e:
        return False, "", str(e)


class Q25ControlCenter(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.zinwa.Q25ControlCenter")
        self.connect("activate", self.on_activate)
        self._updating_ui = False
        self._busy_cellular = False
        self._busy_wifi = False
        self._busy_bt = False
        self._cached_modem = None

    def on_activate(self, app):
        style_mgr = Adw.StyleManager.get_default()
        style_mgr.set_color_scheme(Adw.ColorScheme.PREFER_DARK)

        css = Gtk.CssProvider()
        css.load_from_data(
            b"preferencespage scrolledwindow > viewport > clamp > box { margin-top: 6px; margin-bottom: 6px; border-spacing: 10px; }\n"
            b"preferencesgroup > box > label.heading { margin-bottom: 2px; font-size: 0.92em; }\n"
            b"row.action { min-height: 44px; }\n"
        )
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.win = Adw.ApplicationWindow(application=app)
        self.win.set_title("Q25 Control Center")
        self.win.set_default_size(720, 680)

        self.toast_overlay = Adw.ToastOverlay()
        self.win.set_content(self.toast_overlay)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.toast_overlay.set_child(vbox)

        # Header Bar with ViewSwitcher
        header = Adw.HeaderBar()
        self.stack = Adw.ViewStack()
        switcher = Adw.ViewSwitcher()
        switcher.set_stack(self.stack)
        switcher.set_policy(Adw.ViewSwitcherPolicy.WIDE)
        header.set_title_widget(switcher)

        refresh_btn = Gtk.Button(icon_name="view-refresh-symbolic")
        refresh_btn.set_tooltip_text("Refresh Status (Ctrl+R)")
        refresh_btn.connect("clicked", lambda *_: self.refresh_all(force_modem=True))
        header.pack_start(refresh_btn)

        vbox.append(header)

        # Status Banner Bar
        self.status_label = Gtk.Label(label="Loading hardware telemetry...")
        self.status_label.add_css_class("caption")
        self.status_label.set_margin_top(4)
        self.status_label.set_margin_bottom(4)
        vbox.append(self.status_label)

        self.stack.set_vexpand(True)
        vbox.append(self.stack)

        # Build Tabs
        self._build_quick_page()
        self._build_network_page()
        self._build_system_page()

        #Key controller (Ctrl+Q quit, Ctrl+R refresh, Alt+1/2/3 switch tabs)
        key_ctrl = Gtk.EventControllerKey()
        key_ctrl.connect("key-pressed", self._on_key_pressed)
        self.win.add_controller(key_ctrl)

        start_tab = os.environ.get("Q25_CC_TAB", "")
        if start_tab in ("quick", "network", "system"):
            self.stack.set_visible_child_name(start_tab)

        self.win.present()
        self.refresh_all(force_modem=True)
        GLib.timeout_add_seconds(6, self._periodic_refresh)

    def toast(self, msg):
        GLib.idle_add(lambda: self.toast_overlay.add_toast(Adw.Toast.new(msg)))

    def _on_key_pressed(self, controller, keyval, keycode, state):
        ctrl = bool(state & Gtk.accelerator_get_default_mod_mask() & GLib.ModifierType.CONTROL_MASK)
        alt = bool(state & Gtk.accelerator_get_default_mod_mask() & GLib.ModifierType.ALT_MASK)
        if ctrl and keyval in (ord("q"), ord("Q")):
            self.quit()
            return True
        if ctrl and keyval in (ord("r"), ord("R")):
            self.refresh_all(force_modem=True)
            return True
        if alt and keyval == ord("1"):
            self.stack.set_visible_child_name("quick")
            return True
        if alt and keyval == ord("2"):
            self.stack.set_visible_child_name("network")
            return True
        if alt and keyval == ord("3"):
            self.stack.set_visible_child_name("system")
            return True
        return False

    # -------------------------------------------------------------------------
    # Page 1: Display, Audio & Peripherals
    # -------------------------------------------------------------------------
    def _build_quick_page(self):
        page = Adw.PreferencesPage()

        # Display and Backlight Group
        disp_grp = Adw.PreferencesGroup(title="Display and Keyboard Backlight")
        page.add(disp_grp)

        # Screen Backlight Row (0..1023)
        bl_row = Adw.ActionRow(title="Screen Brightness", subtitle="PWM Backlight (0-1023)")
        self.bl_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 10, 1023, 10)
        self.bl_scale.set_hexpand(True)
        self.bl_scale.set_size_request(220, -1)
        self.bl_scale.set_draw_value(True)
        self.bl_scale.set_value_pos(Gtk.PositionType.LEFT)
