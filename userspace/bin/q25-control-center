        self.route_dropdown.connect("notify::selected", self._on_route_changed)
        route_row.add_suffix(self.route_dropdown)

        test_tone_btn = Gtk.Button(label="Test Tone")
        test_tone_btn.set_valign(Gtk.Align.CENTER)
        test_tone_btn.connect("clicked", self._on_test_tone)
        route_row.add_suffix(test_tone_btn)
        aud_grp.add(route_row)

        # Peripherals Group
        periph_grp = Adw.PreferencesGroup(title="Input and Torch Controls")
        page.add(periph_grp)

        tp_row = Adw.ActionRow(
            title="Optical Trackpad Mode",
            subtitle="ON = Cursor / Mouse Pointer | OFF = Arrow Keys",
        )
        self.tp_switch = Gtk.Switch()
        self.tp_switch.set_valign(Gtk.Align.CENTER)
        self.tp_switch.connect("state-set", self._on_tp_toggled)
        tp_row.add_suffix(self.tp_switch)
        periph_grp.add(tp_row)

        torch_row = Adw.ActionRow(
            title="Rear Flashlight / Torch",
            subtitle="GPIO154/155 Dual LED Torch (Off / Torch / High)",
        )
        self.torch_dropdown = Gtk.DropDown.new_from_strings(["Off", "Torch (Low)", "Flash (High)"])
        self.torch_dropdown.set_valign(Gtk.Align.CENTER)
        self.torch_dropdown.connect("notify::selected", self._on_torch_changed)
        torch_row.add_suffix(self.torch_dropdown)

        vib_btn = Gtk.Button(label="Haptic Buzz")
        vib_btn.set_valign(Gtk.Align.CENTER)
        vib_btn.connect("clicked", self._on_vibrate_clicked)
        torch_row.add_suffix(vib_btn)
        periph_grp.add(torch_row)

        self.stack.add_titled_with_icon(
            page, "quick", "Controls", "preferences-system-symbolic"
        )

