    # -------------------------------------------------------------------------
    # Page 3: Power, Thermal & RGB Status LEDs
    # -------------------------------------------------------------------------
    def _build_system_page(self):
        page = Adw.PreferencesPage()

        pwr_grp = Adw.PreferencesGroup(title="Battery, Charger and Thermal Telemetry")
        page.add(pwr_grp)

        self.bat_row = Adw.ActionRow(title="Battery (MT6358 Gauge + SGM41513)", subtitle="...")
        pwr_grp.add(self.bat_row)

        self.therm_row = Adw.ActionRow(title="SoC and Peripheral Temperatures", subtitle="...")
        pwr_grp.add(self.therm_row)

        self.net_ip_row = Adw.ActionRow(title="IPv4 Interfaces", subtitle="...")
        pwr_grp.add(self.net_ip_row)

        led_grp = Adw.PreferencesGroup(title="Notification RGB LEDs")
        page.add(led_grp)

        led_row = Adw.ActionRow(title="Front Status Indicator LEDs", subtitle="GPIO 46/48/49")
        self.led_red_btn = Gtk.ToggleButton(label="Red")
        self.led_green_btn = Gtk.ToggleButton(label="Green")
        self.led_blue_btn = Gtk.ToggleButton(label="Blue")
        for b, color in (
            (self.led_red_btn, "red"),
            (self.led_green_btn, "green"),
            (self.led_blue_btn, "blue"),
        ):
            b.set_valign(Gtk.Align.CENTER)
            b.connect("toggled", self._on_rgb_toggled, color)
            led_row.add_suffix(b)
        led_grp.add(led_row)

        sys_grp = Adw.PreferencesGroup(title="Kernel and System Actions")
        page.add(sys_grp)

        uname = os.uname()
        kern_row = Adw.ActionRow(
            title="Kernel Release",
            subtitle=f"{uname.sysname} {uname.release} ({uname.machine})",
        )
        term_btn = Gtk.Button(label="Open Foot Terminal")
        term_btn.set_valign(Gtk.Align.CENTER)
        term_btn.connect(
            "clicked",
            lambda *_: subprocess.Popen(["foot"], env={**os.environ, "WAYLAND_DISPLAY": "wayland-0"}),
        )
        kern_row.add_suffix(term_btn)
        sys_grp.add(kern_row)

        self.stack.add_titled_with_icon(
            page, "system", "System", "battery-full-symbolic"
        )

    # -------------------------------------------------------------------------
    # Hardware Callbacks
    # -------------------------------------------------------------------------
    def _on_bl_changed(self, scale):
        if self._updating_ui:
            return
        val = int(scale.get_value())
        write_sysfs("/sys/class/backlight/backlight/bl_power", 0)
        write_sysfs("/sys/class/backlight/backlight/brightness", val)

    def _on_kbd_changed(self, scale):
        if self._updating_ui:
            return
        val = int(scale.get_value())
        write_sysfs("/sys/class/leds/q25:white:kbd_backlight/brightness", val)

    def _on_vol_changed(self, scale):
        if self._updating_ui:
            return
        pct = int(scale.get_value())
        # Update both PipeWire default sink volume and ALSA Lineout Volume (0..18)
        alsa_step = max(0, min(18, round(pct * 18 / 100)))
        threading.Thread(
            target=self._apply_volume_worker, args=(pct, alsa_step), daemon=True
        ).start()

    def _apply_volume_worker(self, pct, alsa_step):
        run_cmd(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{pct}%"], timeout=3)
        run_cmd(["amixer", "-c", "0", "cset", "name=Lineout Volume", f"{alsa_step},{alsa_step}"], timeout=3)
        run_cmd(["amixer", "-c", "0", "cset", "name=Headphone Volume", f"{alsa_step},{alsa_step}"], timeout=3)

    def _on_mute_toggled(self, btn):
        if self._updating_ui:
            return
        muted = btn.get_active()
        threading.Thread(
            target=lambda: run_cmd(
                ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if muted else "0"], timeout=3
            ),
            daemon=True,
        ).start()

    def _on_route_changed(self, dropdown, _pspec):
        if self._updating_ui:
            return
        idx = dropdown.get_selected()
        routes = ["Speaker", "Receiver", "Headphone", "Speaker+Headphone"]
        if 0 <= idx < len(routes):
            rname = routes[idx]
            threading.Thread(
                target=lambda: run_cmd(
                    ["amixer", "-c", "0", "cset", "name=Q25 Output Route", rname], timeout=3
                ),
                daemon=True,
            ).start()
            self.toast(f"Audio route set to {rname}")

    def _on_test_tone(self, _btn):
        def worker():
            run_cmd(
                [
                    "python3",
                    "-c",
                    "import wave,struct,math\n"
                    "with wave.open('/tmp/q25_ui_tone.wav','w') as w:\n"
                    " w.setnchannels(2);w.setsampwidth(2);w.setframerate(48000)\n"
                    " w.writeframes(b''.join(struct.pack('<hh',int(9000*math.sin(2*math.pi*523.25*i/48000)),int(9000*math.sin(2*math.pi*523.25*i/48000))) for i in range(24000)))\n",
                ],
                timeout=5,
            )
            ok, _, _ = run_cmd(["pw-play", "/tmp/q25_ui_tone.wav"], timeout=5)
            if not ok:
                run_cmd(["aplay", "-D", "hw:0,0", "/tmp/q25_ui_tone.wav"], timeout=5)

        threading.Thread(target=worker, daemon=True).start()
        self.toast("Playing 523 Hz test tone...")

    def _on_tp_toggled(self, switch, state):
        if self._updating_ui:
            return False
        write_sysfs("/proc/q20_switch_key_mouse", "1" if state else "0")
        self.toast("Trackpad: Mouse Mode" if state else "Trackpad: Arrow Keys Mode")
        return False

    def _on_torch_changed(self, dropdown, _pspec):
        if self._updating_ui:
            return
        idx = dropdown.get_selected()
        write_sysfs("/sys/class/leds/q25:white:torch/brightness", idx)

    def _on_vibrate_clicked(self, _btn):
        def buzz():
            import time

            write_sysfs("/sys/class/leds/q25:vibrator/brightness", 1)
            time.sleep(0.18)
            write_sysfs("/sys/class/leds/q25:vibrator/brightness", 0)

        threading.Thread(target=buzz, daemon=True).start()

    def _on_rgb_toggled(self, btn, color):
        if self._updating_ui:
            return
        write_sysfs(f"/sys/class/leds/{color}/brightness", 1 if btn.get_active() else 0)

    # -------------------------------------------------------------------------
    # Cellular, Roaming, Wi-Fi & Bluetooth Callbacks
    # -------------------------------------------------------------------------
    def _on_cell_data_toggled(self, switch, state):
        if self._updating_ui or self._busy_cellular:
            return False
        self._busy_cellular = True
        apn = self.apn_entry.get_text().strip() or "ctnet"
        self.toast(f"{'Activating' if state else 'Deactivating'} LTE data ({apn})...")

        def worker():
            try:
                if state:
                    ok, out, err = run_cmd(
                        ["/usr/local/sbin/q25-modem-init", "data-up", apn], timeout=35
                    )
                else:
                    ok, out, err = run_cmd(
                        ["/usr/local/sbin/q25-modem-init", "data-down"], timeout=15
                    )
                msg = (out.splitlines()[-1] if out else err) or ("OK" if ok else "Failed")
                self.toast(f"LTE: {msg}")
            finally:
                self._busy_cellular = False
                GLib.idle_add(lambda: self.refresh_all(force_modem=True))

        threading.Thread(target=worker, daemon=True).start()
        return False

    def _on_roam_toggled(self, switch, state):
        if self._updating_ui or self._busy_cellular:
            return False

        def worker():
            ok, out, err = run_cmd(
                ["/usr/local/sbin/q25-modem-init", "roaming", "1" if state else "0"],
                timeout=12,
            )
            self.toast(out or err or f"Data roaming {'enabled' if state else 'disabled'}")
            GLib.idle_add(lambda: self.refresh_all(force_modem=True))

        threading.Thread(target=worker, daemon=True).start()
        return False

    def _on_apply_apn(self, _btn):
        apn = self.apn_entry.get_text().strip() or "ctnet"
        write_sysfs("/tmp/mtk_props/q25.cellular.apn", apn)
        self.toast(f"Saved APN: {apn}")

    def _on_wifi_toggled(self, switch, state):
        if self._updating_ui or self._busy_wifi:
            return False
        self._busy_wifi = True
        self.toast(f"Turning Wi-Fi {'ON' if state else 'OFF'}...")

        def worker():
            try:
                run_cmd(["nmcli", "radio", "wifi", "on" if state else "off"], timeout=10)
                if state:
                    run_cmd(["ip", "link", "set", "wlan0", "up"], timeout=5)
            finally:
                self._busy_wifi = False
                GLib.idle_add(self.refresh_all)

        threading.Thread(target=worker, daemon=True).start()
        return False

    def _on_wifi_scan(self, _btn):
        self.toast("Scanning Wi-Fi networks on 2.4GHz / 5GHz...")

        def worker():
            ok, out, _ = run_cmd(
                ["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan", "yes"],
                timeout=15,
            )
            ssids = []
            seen = set()
            for line in out.splitlines():
                parts = line.split(":")
                if parts and parts[0] and parts[0] != "--" and parts[0] not in seen:
                    seen.add(parts[0])
                    ssids.append(parts[0])
            if not ssids:
                ssids = ["(No networks found)"]

            def update_combo():
                self._wifi_ssid_list = ssids
                self.wifi_ssid_combo.set_model(Gtk.StringList.new(ssids))
                self.toast(f"Found {len(seen)} Wi-Fi network(s)")

            GLib.idle_add(update_combo)

        threading.Thread(target=worker, daemon=True).start()

    def _on_wifi_connect(self, _btn):
        idx = self.wifi_ssid_combo.get_selected()
        ssids = getattr(self, "_wifi_ssid_list", [])
        if idx >= len(ssids) or ssids[idx].startswith("("):
            self.toast("Scan and select an SSID first")
            return
        ssid = ssids[idx]
        pwd = self.wifi_pass_entry.get_text().strip()
        self.toast(f"Connecting to {ssid}...")

        def worker():
            cmd = ["nmcli", "dev", "wifi", "connect", ssid]
            if pwd:
                cmd += ["password", pwd]
            ok, out, err = run_cmd(cmd, timeout=25)
            self.toast(out if ok else f"Wi-Fi error: {err or out}")
            GLib.idle_add(self.refresh_all)

        threading.Thread(target=worker, daemon=True).start()

    def _on_bt_toggled(self, switch, state):
        if self._updating_ui or self._busy_bt:
            return False
        self._busy_bt = True

        def worker():
            try:
                run_cmd(
                    [
                        "python3",
                        "-c",
                        f"import dbus; b=dbus.SystemBus(); p=dbus.Interface(b.get_object('org.bluez','/org/bluez/hci0'),'org.freedesktop.DBus.Properties'); p.Set('org.bluez.Adapter1','Powered',dbus.Boolean({bool(state)}))",
                    ],
                    timeout=8,
                )
            finally:
                self._busy_bt = False
                GLib.idle_add(self.refresh_all)

        threading.Thread(target=worker, daemon=True).start()
        return False

    def _on_bt_scan(self, _btn):
        self.bt_devices_row.set_subtitle("Scanning Bluetooth / BLE for 4 seconds...")

        def worker():
            code = (
                "import dbus, time\n"
                "bus = dbus.SystemBus()\n"
                "om = dbus.Interface(bus.get_object('org.bluez', '/'), 'org.freedesktop.DBus.ObjectManager')\n"
                "ad = dbus.Interface(bus.get_object('org.bluez', '/org/bluez/hci0'), 'org.bluez.Adapter1')\n"
                "pr = dbus.Interface(bus.get_object('org.bluez', '/org/bluez/hci0'), 'org.freedesktop.DBus.Properties')\n"
                "pr.Set('org.bluez.Adapter1', 'Powered', dbus.Boolean(True))\n"
                "try: ad.StartDiscovery()\n"
                "except Exception: pass\n"
                "time.sleep(4)\n"
                "objs = om.GetManagedObjects()\n"
                "devs = []\n"
                "for p, ifs in objs.items():\n"
                "    if 'org.bluez.Device1' in ifs:\n"
                "        d = ifs['org.bluez.Device1']\n"
                "        devs.append(f\"{d.get('Name', d.get('Alias', d.get('Address', '?')))}\")\n"
                "try: ad.StopDiscovery()\n"
                "except Exception: pass\n"
                "print(f'{len(devs)} found: ' + ', '.join(devs[:6]) if devs else 'No devices found')\n"
            )
            ok, out, err = run_cmd(["python3", "-c", code], timeout=10)
            GLib.idle_add(
                lambda: self.bt_devices_row.set_subtitle(out if ok and out else (err or "Scan failed"))
            )

        threading.Thread(target=worker, daemon=True).start()

    # -------------------------------------------------------------------------
    # Status Refresh
    # -------------------------------------------------------------------------
    def _periodic_refresh(self):
        self.refresh_all(force_modem=False)
        return True

    def refresh_all(self, force_modem=False):
        threading.Thread(
            target=self._gather_state_worker, args=(force_modem,), daemon=True
        ).start()

    def _gather_state_worker(self, force_modem=False):
        state = {}
        state["bl"] = read_sysfs_int("/sys/class/backlight/backlight/brightness", 512)
        state["kbd"] = read_sysfs_int("/sys/class/leds/q25:white:kbd_backlight/brightness", 255)
        state["tp"] = read_sysfs_int("/proc/q20_switch_key_mouse", 1) == 1
        state["torch"] = read_sysfs_int("/sys/class/leds/q25:white:torch/brightness", 0)
        state["led_r"] = read_sysfs_int("/sys/class/leds/red/brightness", 0) > 0
        state["led_g"] = read_sysfs_int("/sys/class/leds/green/brightness", 0) > 0
        state["led_b"] = read_sysfs_int("/sys/class/leds/blue/brightness", 0) > 0
        state["vol"] = getattr(self, "_last_vol", 85)
        state["muted"] = getattr(self, "_last_muted", False)
        state["route_idx"] = getattr(self, "_last_route_idx", 0)

        # Battery & Thermal (instant sysfs)
        cap = read_sysfs_int("/sys/class/power_supply/battery/capacity", 100)
        bstat = read_sysfs_str("/sys/class/power_supply/battery/status", "Unknown")
        vnow = read_sysfs_int("/sys/class/power_supply/battery/voltage_now", 4350000) / 1e6
        cnow = read_sysfs_int("/sys/class/power_supply/battery/current_now", 0) // 1000
        btemp = read_sysfs_int("/sys/class/power_supply/battery/temp", 280) / 10.0
        state["bat_text"] = f"{cap}% ({bstat}) · {vnow:.2f}V · {cnow}mA · {btemp:.1f}°C"

        tz_parts = []
        for idx in range(6):
            ttype = read_sysfs_str(f"/sys/class/thermal/thermal_zone{idx}/type", "")
            tval = read_sysfs_int(f"/sys/class/thermal/thermal_zone{idx}/temp", -1)
            if ttype and tval > 0:
                tz_parts.append(f"{ttype}: {tval/1000.0:.1f}°C")
        state["therm_text"] = " · ".join(tz_parts[:4]) if tz_parts else "Normal"

        # Fast Network IPs
        _, ip_out, _ = run_cmd(["ip", "-4", "-br", "addr"], timeout=2)
        ips = {}
        for line in ip_out.splitlines():
            cols = line.split()
            if len(cols) >= 3:
                ips[cols[0]] = cols[2].split("/")[0]
        state["ips"] = ips

        # Fast Wi-Fi & Bluetooth check
        wlan_flags = read_sysfs_str("/sys/class/net/wlan0/flags", "0x0")
        try:
            wlan_up = (int(wlan_flags, 16) & 0x1) != 0
        except Exception:
            wlan_up = False
        state["wifi_on"] = wlan_up
        state["wifi_sub"] = getattr(
            self,
            "_last_wifi_sub",
            f"IP: {ips.get('wlan0', 'none')} · {'Ready' if wlan_up else 'Radio OFF'}",
        )

        try:
            import dbus

            bus = dbus.SystemBus()
            p = dbus.Interface(
                bus.get_object("org.bluez", "/org/bluez/hci0"),
                "org.freedesktop.DBus.Properties",
            )
            bt_on = bool(p.Get("org.bluez.Adapter1", "Powered"))
            bt_mac = str(p.Get("org.bluez.Adapter1", "Address"))
            state["bt_on"] = bt_on
            state["bt_sub"] = f"MAC: {bt_mac} · {'Powered ON' if bt_on else 'OFF'}"
        except Exception:
            state["bt_on"] = False
            state["bt_sub"] = "Adapter offline"

        # Fast Cellular status from sysfs + cached AT info
        boot_str = read_sysfs_str("/sys/kernel/ccci/boot", "")
        md_ready = "md1:4" in boot_str
        ccmni_ip = ips.get("ccmni0", "")
        apn_val = read_sysfs_str("/tmp/mtk_props/q25.cellular.apn", "ctnet") or "ctnet"
        roam_val = read_sysfs_str("/tmp/mtk_props/q25.cellular.roaming", "0") == "1"
        if self._cached_modem:
            m = dict(self._cached_modem)
            m["md_state"] = "ready" if md_ready else "off"
            m["ipv4"] = ccmni_ip
            m["data_enabled"] = bool(ccmni_ip)
            m["apn"] = apn_val
            m["roaming"] = roam_val
            state["modem"] = m
        else:
            state["modem"] = {
                "md_state": "ready" if md_ready else "off",
                "sim": "READY" if md_ready else "ABSENT",
                "operator": "46011" if ccmni_ip else "",
                "reg": "Home LTE" if ccmni_ip else ("Searching" if md_ready else "Unregistered"),
                "csq": 14 if md_ready else 0,
                "ipv4": ccmni_ip,
                "data_enabled": bool(ccmni_ip),
                "roaming": roam_val,
                "apn": apn_val,
            }

        state["Banner"] = (
            f"Bat: {cap}% ({btemp:.0f}°C) | "
            f"LTE: {ips.get('ccmni0', 'off')} | "
            f"Wi-Fi: {ips.get('wlan0', 'off')} | "
            f"USB: {ips.get('usb0', 'off')}"
        )

        # Stage 1: Immediate UI update (<100ms)
        GLib.idle_add(self._apply_state_to_ui, dict(state))

        # Stage 2: Audio & NetworkManager / Modem details
        ok, vout, _ = run_cmd(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], timeout=2)
        if ok and "Volume:" in vout:
            try:
                self._last_vol = int(round(float(vout.split()[1]) * 100))
                self._last_muted = "MUTED" in vout
                state["vol"] = self._last_vol
                state["muted"] = self._last_muted
            except Exception:
                pass

        ok, rout, _ = run_cmd(["amixer", "-c", "0", "cget", "name=Q25 Output Route"], timeout=2)
        if ok and ": values=" in rout:
            try:
                self._last_route_idx = max(
                    0, min(3, int(rout.split(": values=")[-1].splitlines()[0].strip()))
                )
                state["route_idx"] = self._last_route_idx
            except Exception:
                pass

        _, wf_dev, _ = run_cmd(["nmcli", "-t", "-f", "DEVICE,STATE,CONNECTION", "dev"], timeout=2)
        wf_conn = ""
        for line in wf_dev.splitlines():
            if line.startswith("wlan0:"):
                parts = line.split(":")
                if len(parts) >= 3:
                    wf_conn = f"{parts[1]} ({parts[2] or 'no AP'})"
        if wf_conn:
            self._last_wifi_sub = f"IP: {ips.get('wlan0', 'none')} · {wf_conn}"
            state["wifi_sub"] = self._last_wifi_sub

        if not self._busy_cellular and (force_modem or self._cached_modem is None):
            ok, mjson, _ = run_cmd(["/usr/local/sbin/q25-modem-init", "status"], timeout=5)
            if ok and mjson.startswith("{"):
                try:
                    m = json.loads(mjson)
                    self._cached_modem = m
                    state["modem"] = m
                except Exception:
                    pass

        GLib.idle_add(self._apply_state_to_ui, dict(state))

    def _apply_state_to_ui(self, s):
        self._updating_ui = True
        try:
            self.status_label.set_text(s.get("Banner", ""))
            self.bl_scale.set_value(s.get("bl", 512))
            self.kbd_scale.set_value(s.get("kbd", 255))
            self.vol_scale.set_value(s.get("vol", 85))
            self.mute_toggle.set_active(s.get("muted", False))
            self.route_dropdown.set_selected(s.get("route_idx", 0))
            self.tp_switch.set_active(s.get("tp", True))
            self.torch_dropdown.set_selected(max(0, min(2, s.get("torch", 0))))

            self.led_red_btn.set_active(s.get("led_r", False))
            self.led_green_btn.set_active(s.get("led_g", False))
            self.led_blue_btn.set_active(s.get("led_b", False))

            self.bat_row.set_subtitle(s.get("bat_text", ""))
            self.therm_row.set_subtitle(s.get("therm_text", ""))
            ips = s.get("ips", {})
            self.net_ip_row.set_subtitle(
                f"ccmni0: {ips.get('ccmni0', '-')} · wlan0: {ips.get('wlan0', '-')} · usb0: {ips.get('usb0', '-')}"
            )

            self.wifi_switch.set_active(s.get("wifi_on", False))
            self.wifi_row.set_subtitle(s.get("wifi_sub", ""))
            self.bt_switch.set_active(s.get("bt_on", False))
            self.bt_row.set_subtitle(s.get("bt_sub", ""))

            m = s.get("modem")
            if m:
                self.cell_status_row.set_subtitle(
                    f"MD: {m.get('md_state')} · SIM: {m.get('sim')} · Net: {m.get('operator') or '-'} ({m.get('reg')}) · CSQ: {m.get('csq')} · IP: {m.get('ipv4') or 'none'}"
                )
                self.cell_data_switch.set_active(bool(m.get("data_enabled")))
                self.roam_switch.set_active(bool(m.get("roaming")))
                if m.get("apn") and not self.apn_entry.has_focus():
                    self.apn_entry.set_text(m.get("apn"))
        finally:
            self._updating_ui = False


if __name__ == "__main__":
    app = Q25ControlCenter()
    app.run()
