        self.kbd_scale.set_value_pos(Gtk.PositionType.LEFT)
        self.kbd_scale.connect("value-changed", self._on_kbd_changed)
        kbd_row.add_suffix(self.kbd_scale)
        disp_grp.add(kbd_row)

