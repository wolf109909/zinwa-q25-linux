#!/bin/sh
NODE="/proc/q20_switch_key_mouse"
[ -w "$NODE" ] || exit 1
CUR=$(cat "$NODE" 2>/dev/null || echo 0)
case "${1:-toggle}" in
  0|mouse) NEW=0 ;;
  1|keys|arrows) NEW=1 ;;
  *) [ "$CUR" = "1" ] && NEW=0 || NEW=1 ;;
esac
echo "$NEW" > "$NODE" 2>/dev/null || true
if [ "$NEW" = "0" ]; then
  echo "Trackpad: Mouse Mode (0)"
else
  echo "Trackpad: Arrow Keys Mode (1)"
fi
