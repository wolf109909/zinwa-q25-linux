#!/bin/sh
ACTION="${1:-up}"
if [ -d /opt/arch/usr/bin ]; then
  RUN_ARCH="chroot /opt/arch"
else
  RUN_ARCH=""
fi

case "$ACTION" in
  up|+)
    STEP="+5%"
    ALSA_DELTA=1
    ;;
  down|-)
    STEP="5%-"
    ALSA_DELTA=-1
    ;;
  mute)
    $RUN_ARCH env XDG_RUNTIME_DIR=/run/user/0 /usr/bin/wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle >/dev/null 2>&1 || true
    exit 0
    ;;
  *)
    exit 0
    ;;
esac

$RUN_ARCH env XDG_RUNTIME_DIR=/run/user/0 /usr/bin/wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "$STEP" >/dev/null 2>&1 || true

CUR=$($RUN_ARCH /usr/bin/amixer -c 0 cget name='Lineout Volume' 2>/dev/null | sed -n 's/.*: values=\([0-9]*\).*/\1/p' | head -n 1)
[ -n "$CUR" ] || CUR=16
NEW=$(( CUR + ALSA_DELTA ))
[ "$NEW" -lt 0 ] && NEW=0
[ "$NEW" -gt 18 ] && NEW=18
$RUN_ARCH /usr/bin/amixer -c 0 cset name='Lineout Volume' "${NEW},${NEW}" >/dev/null 2>&1 || true
$RUN_ARCH /usr/bin/amixer -c 0 cset name='Headphone Volume' "${NEW},${NEW}" >/dev/null 2>&1 || true
