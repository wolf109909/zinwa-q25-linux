#!/usr/bin/env python3
"""
Zinwa Q25 Native GTK4 / Libadwaita Terminal Emulator
Uses bidirectional UNIX pipes (independent of devpts) so interactive shells
and commands run cleanly with zero CPU spin on Mainline Linux 7.3.3-cachyos-q25.
"""

import os
import subprocess
import threading
import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Gdk, Adw, GLib, Pango


class Q25TerminalApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.zinwa.Q25Terminal")
        self.proc = None
        self.cwd = os.path.expanduser("~")
        if not os.path.isdir(self.cwd):
            self.cwd = "/"
        self.history = []
        self.hist_idx = 0

    def do_activate(self):
        win = self.props.active_window
        if win:
            win.present()
            return

        self.win = Adw.ApplicationWindow(application=self)
        self.win.set_title("Q25 Terminal")
        self.win.set_default_size(700, 680)

        css = Gtk.CssProvider()
        css.load_from_data(
            b"""
            textview.q25-term {
                background-color: #111318;
                color: #e2e8f0;
                font-family: monospace;
                font-size: 11pt;
                padding: 8px;
            }
            entry.q25-cmd {
                font-family: monospace;
                font-size: 11pt;
            }
            """
        )
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.win.set_content(vbox)

        header = Adw.HeaderBar()
        title_lbl = Gtk.Label(label="Zinwa Q25 Terminal (Arch Linux ARM)")
        title_lbl.add_css_class("heading")
        header.set_title_widget(title_lbl)

        clear_btn = Gtk.Button(icon_name="edit-clear-all-symbolic")
        clear_btn.set_tooltip_text("Clear Screen (Ctrl+L)")
        clear_btn.connect("clicked", lambda *_: self.buf.set_text(""))
        header.pack_start(clear_btn)

        vbox.append(header)

        # Quick action chips for one-tap mobile/keyboard convenience
        quick_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        quick_box.set_margin_start(6)
        quick_box.set_margin_end(6)
        quick_box.set_margin_top(4)
        quick_box.set_margin_bottom(4)
        for label, cmd in (
            ("Status", "q25-status"),
            ("Sensors", "grep '' /sys/bus/iio/devices/iio:device*/name /sys/bus/iio/devices/iio:device*/*raw* /sys/bus/iio/devices/iio:device*/*input* 2>/dev/null"),
            ("IP / Route", "ip -4 addr; ip route"),
            ("Top", "top -b -n 1 | head -n 20"),
            ("dmesg", "dmesg | tail -n 25"),
        ):
            b = Gtk.Button(label=label)
            b.connect("clicked", lambda _b, c=cmd: self._run_command(c))
            quick_box.append(b)
        vbox.append(quick_box)

        scroller = Gtk.ScrolledWindow()
        scroller.set_vexpand(True)
        scroller.set_hexpand(True)
        self.scroller = scroller

        self.textview = Gtk.TextView()
        self.textview.set_editable(False)
        self.textview.set_cursor_visible(False)
        self.textview.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.textview.add_css_class("q25-term")
        self.buf = self.textview.get_buffer()
        scroller.set_child(self.textview)
        vbox.append(scroller)

        cmd_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        cmd_box.set_margin_start(6)
        cmd_box.set_margin_end(6)
        cmd_box.set_margin_top(6)
        cmd_box.set_margin_bottom(6)

        self.prompt_lbl = Gtk.Label(label="root@q25:#")
        self.prompt_lbl.add_css_class("monospace")
        cmd_box.append(self.prompt_lbl)

        self.entry = Gtk.Entry()
        self.entry.set_hexpand(True)
        self.entry.set_placeholder_text("Enter shell command...")
        self.entry.add_css_class("q25-cmd")
        self.entry.connect("activate", self._on_entry_activate)

        key_ctrl = Gtk.EventControllerKey()
        key_ctrl.connect("key-pressed", self._on_key_pressed)
        self.entry.add_controller(key_ctrl)
        cmd_box.append(self.entry)

        run_btn = Gtk.Button(label="Run")
        run_btn.add_css_class("suggested-action")
        run_btn.connect("clicked", self._on_entry_activate)
        cmd_box.append(run_btn)

        vbox.append(cmd_box)

        uname = os.uname()
        self._append_text(
            f"Zinwa Q25 Arch Linux ARM — {uname.sysname} {uname.release} ({uname.machine})\n"
            f"Type any command below or tap a quick button above.\n\n"
        )
        self.win.present()
        self.entry.grab_focus()

    def _append_text(self, text):
        def do_append():
            end_iter = self.buf.get_end_iter()
            self.buf.insert(end_iter, text)
            mark = self.buf.create_mark(None, self.buf.get_end_iter(), False)
            self.textview.scroll_mark_onscreen(mark)
            return False

        GLib.idle_add(do_append)

    def _on_key_pressed(self, _ctrl, keyval, _keycode, state):
        ctrl = bool(state & Gtk.accelerator_get_default_mod_mask() & Gdk.ModifierType.CONTROL_MASK)
        if ctrl and keyval in (ord("l"), ord("L")):
            self.buf.set_text("")
            return True
        if ctrl and keyval in (ord("q"), ord("Q")):
            self.quit()
            return True
        if keyval == Gdk.KEY_Up and self.history:
            self.hist_idx = max(0, self.hist_idx - 1)
            self.entry.set_text(self.history[self.hist_idx])
            self.entry.set_position(-1)
            return True
        if keyval == Gdk.KEY_Down and self.history:
            self.hist_idx = min(len(self.history), self.hist_idx + 1)
            if self.hist_idx < len(self.history):
                self.entry.set_text(self.history[self.hist_idx])
                self.entry.set_position(-1)
            else:
                self.entry.set_text("")
            return True
        return False

    def _on_entry_activate(self, *_):
        cmd = self.entry.get_text().strip()
        if not cmd:
            return
        self.entry.set_text("")
        self.history.append(cmd)
        self.hist_idx = len(self.history)
        self._run_command(cmd)

    def _run_command(self, cmd):
        if cmd in ("clear", "cls"):
            self.buf.set_text("")
            return
        if cmd in ("exit", "quit"):
            self.quit()
            return

        self._append_text(f"[{self.cwd}]# {cmd}\n")

        if cmd == "cd" or cmd.startswith("cd "):
            target = cmd[3:].strip() if len(cmd) > 2 else os.path.expanduser("~")
            target = os.path.expanduser(target or "~")
            new_dir = os.path.normpath(os.path.join(self.cwd, target))
            if os.path.isdir(new_dir):
                self.cwd = new_dir
                GLib.idle_add(lambda: self.prompt_lbl.set_text(f"root@q25:{os.path.basename(self.cwd) or '/'}#"))
            else:
                self._append_text(f"cd: {target}: No such directory\n\n")
            return

        def worker():
            try:
                env = dict(os.environ)
                env["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
                env["TERM"] = "dumb"
                r = subprocess.run(
                    ["/bin/bash", "-c", cmd],
                    cwd=self.cwd,
                    env=env,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    timeout=60,
                )
                out = r.stdout or ""
                if out and not out.endswith("\n"):
                    out += "\n"
                if r.returncode != 0:
                    out += f"[exit {r.returncode}]\n"
                self._append_text(out + "\n")
            except Exception as e:
                self._append_text(f"Error: {e}\n\n")

        threading.Thread(target=worker, daemon=True).start()


if __name__ == "__main__":
    app = Q25TerminalApp()
    app.run()
