#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Zinwa Q25 (MT6789) cellular modem (MD1) initialization and LTE data helper
# Usage:
#   q25-modem-init start      - Mount vendor/system/nvdata, start CCCI daemons, wait for MD1 ready
#   q25-modem-init data-up    - Register LTE, activate APN, configure ccmni0 IPv4 + default route + DNS
#   q25-modem-init data-down  - Deactivate PDN and bring down ccmni0
#   q25-modem-init roaming [0|1] - Disable/enable data roaming
#   q25-modem-init status     - Print JSON modem status

# Always execute inside the Arch Linux ARM rootfs when called from the outer initramfs
if [ ! -f /etc/arch-release ] && [ -x /rootfs/usr/local/sbin/q25-modem-init ]; then
    exec chroot /rootfs /usr/local/sbin/q25-modem-init "$@"
fi

APN_FILE="/etc/q25-apn.conf"
DEFAULT_APN="ctnet"
if [ -s /tmp/mtk_props/q25.cellular.apn ]; then
    APN=$(cat /tmp/mtk_props/q25.cellular.apn | tr -d ' \r\n')
elif [ -f "$APN_FILE" ]; then
    APN=$(cat "$APN_FILE" | tr -d ' \r\n')
fi
[ -z "$APN" ] && APN="$DEFAULT_APN"

is_mounted() {
    grep -qs " $1 " /proc/mounts
}

run_python() {
    if command -v python3 >/dev/null 2>&1; then
        python3 "$@"
    else
        chroot /opt/arch python3 "$@"
    fi
}

ensure_mounts_and_links() {
    if [ ! -e /dev/block/by-name/nvdata ]; then
        mkdir -p /dev/block/by-name /dev/block/platform/bootdevice/by-name
        for d in /sys/block/sdc/sdc*; do
            [ -f "$d/uevent" ] || continue
            dev=$(basename "$d")
            part=$(grep "^PARTNAME=" "$d/uevent" | cut -d= -f2)
            if [ -n "$part" ]; then
                ln -sf "/dev/$dev" "/dev/block/by-name/$part"
                ln -sf "/dev/$dev" "/dev/block/platform/bootdevice/by-name/$part"
            fi
        done
    fi

    mkdir -p /mnt/vendor/nvdata /mnt/vendor/nvcfg /mnt/vendor/protect_f /mnt/vendor/protect_s /mnt/vendor/persist
    is_mounted /mnt/vendor/nvdata || mount -t ext4 /dev/block/by-name/nvdata /mnt/vendor/nvdata 2>/dev/null || true
    is_mounted /mnt/vendor/nvcfg || mount -t ext4 /dev/block/by-name/nvcfg /mnt/vendor/nvcfg 2>/dev/null || true
    is_mounted /mnt/vendor/protect_f || mount -t ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f 2>/dev/null || true
    is_mounted /mnt/vendor/protect_s || mount -t ext4 /dev/block/by-name/protect2 /mnt/vendor/protect_s 2>/dev/null || true

    if [ ! -f /vendor/bin/ccci_mdinit ]; then
        losetup -o $((9177088 * 512)) /dev/loop0 /dev/sdc59 2>/dev/null || true
        mkdir -p /vendor
        mount -o ro /dev/loop0 /vendor 2>/dev/null || true
    fi
    if [ ! -d /tmp/sys_a/system/lib64 ]; then
        losetup -o $((5302272 * 512)) /dev/loop1 /dev/sdc59 2>/dev/null || true
        mkdir -p /tmp/sys_a
        mount -o ro /dev/loop1 /tmp/sys_a 2>/dev/null || true
    fi

    if [ ! -f /apex/com.android.runtime/lib64/bionic/libc.so ]; then
        mkdir -p /apex/com.android.runtime/bin \
                 /apex/com.android.runtime/lib64/bionic \
                 /apex/com.android.runtime/lib/bionic \
                 /apex/com.android.vndk.v30/lib64 \
                 /apex/com.android.vndk.v30/lib
        cp -af /tmp/sys_a/system/bin/bootstrap/* /apex/com.android.runtime/bin/ 2>/dev/null || true
        cp -af /tmp/sys_a/system/lib64/bootstrap/* /apex/com.android.runtime/lib64/bionic/ 2>/dev/null || true
        cp -af /tmp/sys_a/system/lib64/bootstrap/* /apex/com.android.runtime/lib64/ 2>/dev/null || true
        cp -af /tmp/sys_a/system/lib/bootstrap/* /apex/com.android.runtime/lib/bionic/ 2>/dev/null || true
        cp -af /tmp/sys_a/system/lib/bootstrap/* /apex/com.android.runtime/lib/ 2>/dev/null || true
    fi

    if [ ! -L /system/lib64 ]; then
        mkdir -p /system
        ln -snf /tmp/sys_a/system/lib64 /system/lib64 2>/dev/null || true
        ln -snf /tmp/sys_a/system/lib /system/lib 2>/dev/null || true
        ln -snf /tmp/sys_a/system/bin /system/bin 2>/dev/null || true
        ln -snf /tmp/sys_a/system/etc /system/etc 2>/dev/null || true
    fi

    mkdir -p /tmp/mtk_props /data/vendor/ccci_cfg /data/vendor/mdlpm /data/vendor/md3 /data/vendor_de/md \
             /mnt/vendor/nvdata/md /mnt/vendor/nvdata/md3 /var/log
    [ -f /tmp/mtk_props/vendor.service.nvram_restore ] || echo -n "Ready" > /tmp/mtk_props/vendor.service.nvram_restore
    [ -f /tmp/mtk_props/ro.boot.opt_c2k_support ] || echo -n "0" > /tmp/mtk_props/ro.boot.opt_c2k_support
    [ -f /tmp/mtk_props/ro.vendor.mtk_protocol1_rat_config ] || echo -n "Lf/Lt/W/G" > /tmp/mtk_props/ro.vendor.mtk_protocol1_rat_config
    [ -f /tmp/mtk_props/ro.boot.opt_md1_support ] || echo -n "Lf/Lt/W/G" > /tmp/mtk_props/ro.boot.opt_md1_support
    [ -f /tmp/mtk_props/ro.vendor.mtk_md1_support ] || echo -n "1" > /tmp/mtk_props/ro.vendor.mtk_md1_support
    [ -f /tmp/mtk_props/persist.vendor.radio.mtk_ps2_rat ] || echo -n "0" > /tmp/mtk_props/persist.vendor.radio.mtk_ps2_rat

    if [ ! -s /tmp/libprop_preload.so ]; then
        if [ -f /usr/local/sbin/libprop_preload.so ]; then
            cp -f /usr/local/sbin/libprop_preload.so /tmp/libprop_preload.so
        elif [ -f /opt/arch/usr/local/sbin/libprop_preload.so ]; then
            cp -f /opt/arch/usr/local/sbin/libprop_preload.so /tmp/libprop_preload.so
        fi
    fi
}

start_daemons() {
    # Fast path: if both daemons are alive and MD1 is ready, do not touch files or processes
    if pidof ccci_rpcd >/dev/null 2>&1 && pidof ccci_mdinit >/dev/null 2>&1 && \
       grep -q "md1:4" /sys/kernel/ccci/boot 2>/dev/null && [ -c /dev/ttyC0 ]; then
        return 0
    fi

    ensure_mounts_and_links
    # Note: ccci_fsd is embedded as a thread inside ccci_mdinit on MT6789;
    # starting standalone /vendor/bin/ccci_fsd steals /dev/ccci_fs and causes EBUSY!
    killall -9 ccci_fsd 2>/dev/null || true

    # If MD1 is in exception state (md1:5) or one of the two daemons died, restart both cleanly
    # so ccci_rpcd is listening on /dev/ccci_rpc before ccci_mdinit triggers MD1 Handshake 1/2.
    if grep -q "md1:5" /sys/kernel/ccci/boot 2>/dev/null || \
       ! pidof ccci_rpcd >/dev/null 2>&1 || ! pidof ccci_mdinit >/dev/null 2>&1; then
        killall -9 ccci_mdinit ccci_rpcd 2>/dev/null || true
        sleep 1
    fi

    LPATH64="/vendor/lib64:/tmp/sys_a/system/lib64:/tmp/sys_a/system/lib64/bootstrap:/apex/com.android.runtime/lib64:/apex/com.android.runtime/lib64/bionic"
    if ! pidof ccci_rpcd >/dev/null 2>&1; then
        setsid env LD_PRELOAD=/tmp/libprop_preload.so LD_LIBRARY_PATH="$LPATH64" /vendor/bin/ccci_rpcd 0 </dev/null >/var/log/ccci_rpcd.log 2>&1 &
        sleep 1
    fi
    if ! pidof ccci_mdinit >/dev/null 2>&1; then
        setsid env LD_PRELOAD=/tmp/libprop_preload.so LD_LIBRARY_PATH="$LPATH64" /vendor/bin/ccci_mdinit 0 </dev/null >/var/log/ccci_mdinit.log 2>&1 &
    fi

    for i in $(seq 1 25); do
        if grep -q "md1:4" /sys/kernel/ccci/boot 2>/dev/null && [ -c /dev/ttyC0 ]; then
            break
        fi
        sleep 1
    done
}

case "${1:-start}" in
    start)
        start_daemons
        cat /sys/kernel/ccci/boot 2>/dev/null || true
        ;;
    data-up)
        if [ -n "$2" ]; then
            APN=$(echo "$2" | tr -d ' \r\n')
            mkdir -p /tmp/mtk_props
            echo -n "$APN" > /tmp/mtk_props/q25.cellular.apn
            echo "$APN" > "$APN_FILE" 2>/dev/null || true
        fi
        mkdir -p /tmp/mtk_props
        echo -n "1" > /tmp/mtk_props/q25.cellular.data_enabled
        start_daemons
        ip link set ccmni0 mtu 1400 up 2>/dev/null || true
        run_python - "$APN" << 'PYEOF'
import os, sys, time, re, select, subprocess

apn = sys.argv[1] if len(sys.argv) > 1 else "ctnet"
if not os.path.exists("/dev/ttyC0"):
    print("ERROR: /dev/ttyC0 not ready")
    sys.exit(1)

try:
    fd = os.open("/dev/ttyC0", os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
except OSError as e:
    print(f"ERROR: cannot open /dev/ttyC0: {e}")
    sys.exit(1)

def cmd(s, wait=0.5):
    try:
        os.write(fd, (s + "\r\n").encode())
    except OSError:
        return ""
    end = time.time() + wait
    out = b""
    while time.time() < end:
        r, _, _ = select.select([fd], [], [], 0.05)
        if r:
            try:
                c = os.read(fd, 4096)
                if not c:
                    break
                out += c
            except OSError:
                break
    return out.decode(errors="ignore")

cmd("ATE0", 0.3)
cmd("AT+CMEE=1", 0.3)
cfun = cmd("AT+CFUN?", 0.4)
if "+CFUN: 1" not in cfun:
    cmd("AT+EFUN=1", 1.0)
    cmd("AT+CFUN=1", 2.0)

cmd("AT+EGTYPE=4", 0.4)
cmd("AT+EAPNLOCK=1", 0.4)
cmd('AT+EAPNSET="",1,"",""', 0.4)
cmd(f'AT+EAPNSET="{apn}",2,"type=default,supl;protocol=IPV4V6;roaming_protocol=IPV4V6;authtype=0;carrier_enabled=1;max_conns=0;max_conns_time=0;wait_time=0;bearer_bitmask=0;inactive_timer=0"', 0.5)
cmd("AT+EAPNLOCK=0", 0.4)
cmd("AT+ECNCFG=1,,,1,1,1", 0.4)
cmd(f'AT+EIAAPN="{apn}",0,"IPV4V6","IPV4V6",0,"",""', 0.6)
cmd("AT+EIAREG=1", 0.4)
cmd("AT+EDALLOW=1", 0.4)

resp = ""
addr_resp = ""
ipv4 = None
if_id = 100
try:
    with open("/tmp/mtk_props/q25.cellular.if_id") as f:
        if_id = int(f.read().strip())
except Exception:
    pass

for attempt in range(4):
    resp = cmd(f'AT+EAPNACT=1,"{apn}","default",0', 1.8)
    m_eif = re.search(r'\+EIF:\s*(\d+)\s*,\s*ifup', resp)
    if m_eif:
        if_id = int(m_eif.group(1))
        try:
            with open("/tmp/mtk_props/q25.cellular.if_id", "w") as f:
                f.write(str(if_id))
        except Exception:
            pass
    cmd(f'AT+EIF={if_id}, "ifst", "up", 3', 0.6)
    cmd("AT+EAPNACT=3,0", 0.5)
    addr_resp = cmd('AT+EPDN=0,"addr"', 0.6) + "\n" + cmd("AT+CGCONTRDP", 0.6)
    m = re.search(r'\b(10\.\d+\.\d+\.\d+|100\.\d+\.\d+\.\d+|172\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+)\b', resp + "\n" + addr_resp)
    if m:
        ipv4 = m.group(1)
        break
    time.sleep(1.5)

try:
    os.close(fd)
except OSError:
    pass

if ipv4:
    ccmni_idx = if_id % 100 if (if_id % 100) <= 20 else 0
    ccmni_dev = f"ccmni{ccmni_idx}"
    try:
        with open("/tmp/mtk_props/q25.cellular.ifname", "w") as f:
            f.write(ccmni_dev)
    except Exception:
        pass
    for idx in range(8):
        dev = f"ccmni{idx}"
        if dev != ccmni_dev:
            subprocess.run(["ip", "-4", "addr", "flush", "dev", dev], check=False, stderr=subprocess.DEVNULL)
            subprocess.run(["ip", "link", "set", dev, "down"], check=False, stderr=subprocess.DEVNULL)
    subprocess.run(["ip", "link", "set", ccmni_dev, "mtu", "1400", "up"], check=False)
    subprocess.run(["ip", "-4", "addr", "flush", "dev", ccmni_dev], check=False)
    subprocess.run(["ip", "addr", "add", f"{ipv4}/24", "dev", ccmni_dev], check=False)
    subprocess.run(["ip", "route", "replace", "default", "dev", ccmni_dev, "metric", "100"], check=False)
    with open("/etc/resolv.conf", "w") as f:
        f.write("nameserver 223.5.5.5\nnameserver 119.29.29.29\n")
    print(f"LTE UP: {ipv4} on {ccmni_dev} (APN {apn})")
else:
    print("LTE enabled (waiting for carrier PDN registration)")
PYEOF
        ;;
    data-down)
        mkdir -p /tmp/mtk_props
        echo -n "0" > /tmp/mtk_props/q25.cellular.data_enabled
        if [ -c /dev/ttyC0 ]; then
            run_python - << 'PYEOF'
import os, select, time
try:
    fd = os.open("/dev/ttyC0", os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    os.write(fd, b"AT+EAPNACT=0,0\r\n")
    end = time.time() + 0.5
    while time.time() < end:
        r, _, _ = select.select([fd], [], [], 0.05)
        if r:
            try: os.read(fd, 4096)
            except OSError: break
    os.close(fd)
except OSError:
    pass
PYEOF
        fi
        for idx in 0 1 2 3 4 5 6 7; do
            ip addr flush dev "ccmni${idx}" 2>/dev/null || true
            ip link set "ccmni${idx}" down 2>/dev/null || true
        done
        echo "LTE DOWN"
        ;;
    roaming)
        MODE="${2:-1}"
        mkdir -p /tmp/mtk_props
        echo -n "$MODE" > /tmp/mtk_props/ro.com.android.dataroaming
        echo -n "$MODE" > /tmp/mtk_props/q25.cellular.roaming
        if [ -c /dev/ttyC0 ]; then
            run_python - "$MODE" << 'PYEOF'
import os, sys, select, time
mode = "1" if sys.argv[1] == "1" else "0"
try:
    fd = os.open("/dev/ttyC0", os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    os.write(fd, f"AT+EROAMING={mode}\r\n".encode())
    end = time.time() + 0.4
    while time.time() < end:
        r, _, _ = select.select([fd], [], [], 0.05)
        if r:
            try: os.read(fd, 4096)
            except OSError: break
    os.close(fd)
except OSError:
    pass
PYEOF
        fi
        echo "Roaming: $MODE"
        ;;
    status)
        run_python - "$APN" << 'PYEOF'
import os, sys, time, re, json, select, subprocess

apn_default = sys.argv[1] if len(sys.argv) > 1 else "ctnet"
res = {
    "md_state": "off",
    "sim": "absent",
    "operator": "-",
    "csq": 0,
    "reg": "unregistered",
    "ipv4": "",
    "data_enabled": False,
    "roaming": False,
    "apn": apn_default,
}
try:
    with open("/sys/kernel/ccci/boot") as f:
        b = f.read().strip()
        if "md1:4" in b: res["md_state"] = "ready"
        elif "md1:3" in b: res["md_state"] = "booting"
        elif "md1:5" in b: res["md_state"] = "exception"
except Exception:
    pass

for p in ("/tmp/mtk_props/q25.cellular.roaming", "/tmp/mtk_props/ro.com.android.dataroaming"):
    try:
        with open(p) as f:
            res["roaming"] = f.read().strip() == "1"
            break
    except Exception:
        pass

try:
    with open("/tmp/mtk_props/q25.cellular.apn") as f:
        v = f.read().strip()
        if v:
            res["apn"] = v
except Exception:
    pass

try:
    for idx in range(8):
        out = subprocess.check_output(["ip", "-4", "addr", "show", "dev", f"ccmni{idx}"], text=True, stderr=subprocess.DEVNULL)
        m = re.search(r'inet (\d+\.\d+\.\d+\.\d+)', out)
        if m:
            res["ipv4"] = m.group(1)
            res["ifname"] = f"ccmni{idx}"
            break
except Exception:
    pass

data_flag = False
try:
    with open("/tmp/mtk_props/q25.cellular.data_enabled") as f:
        data_flag = f.read().strip() == "1"
except Exception:
    pass
res["data_enabled"] = bool(res["ipv4"]) or data_flag

if res["md_state"] == "ready" and os.path.exists("/dev/ttyC0"):
    try:
        fd = os.open("/dev/ttyC0", os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        def q(s, wait=0.25):
            os.write(fd, (s + "\r\n").encode())
            end = time.time() + wait
            ans = b""
            while time.time() < end:
                r, _, _ = select.select([fd], [], [], 0.04)
                if r:
                    try:
                        c = os.read(fd, 4096)
                        if not c: break
                        ans += c
                    except OSError:
                        break
            return ans.decode(errors="ignore")
        txt = "\n".join([
            q("ATE0", 0.15),
            q("AT+CPIN?", 0.2),
            q("AT+CSQ", 0.2),
            q("AT+CEREG?", 0.2),
            q("AT+COPS?", 0.2),
        ])
        os.close(fd)
        if "READY" in txt:
            res["sim"] = "READY"
        m = re.search(r'\+CSQ:\s*(\d+)', txt)
        if m:
            csq = int(m.group(1))
            res["csq"] = 0 if csq == 99 else csq
        m = re.search(r'\+CEREG:\s*\d+,(\d+)', txt)
        if m:
            st = m.group(1)
            res["reg"] = {"1": "Home LTE", "5": "Roaming LTE", "2": "Searching", "3": "Denied"}.get(st, f"State {st}")
        m = re.search(r'\+COPS:\s*\d+,\d+,"([^"]+)"', txt)
        if m:
            res["operator"] = m.group(1)
    except Exception:
        pass

print(json.dumps(res))
PYEOF
        ;;
esac
