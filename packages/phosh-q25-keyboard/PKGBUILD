# SPDX-License-Identifier: GPL-3.0-or-later
pkgname=phosh-q25-keyboard
pkgver=0.57.0
pkgrel=1
pkgdesc='Q25 Caps/Shift and Sym status icons for the stock Phosh top panel'
arch=('aarch64')
url='https://phosh.mobi'
license=('GPL-3.0-or-later')
# Pin the extension ABI and equal-priority ordering to the reviewed release.
depends=('phosh=0.57.0' 'gtk3' 'keyd-q25=2.6.0')
makedepends=('gcc' 'pkgconf' 'glib2-devel')
source=("https://sources.phosh.mobi/releases/phosh/phosh-$pkgver.tar.xz"
        'q25-keyboard.c' 'q25-keyboard.plugin' 'q25-keyboard.gresources.xml'
        'q25-shift-symbolic.svg' 'q25-caps-lock-symbolic.svg' 'q25-sym-symbolic.svg')
sha256sums=(
    '30cd0eb182b92846162ab57516170ca09fe8ce08ef95703ee351af7b9c2b9520'
    'e2a8431b0f21eccc5d8e0355c1e28b0dab9ac3177300768aafc385808a53ab46'
    '8a129c0d967a22d21832d4760d959a038dd7311a1a107ff91a8839fc0f8f5b76'
    'aec52a5680ef55726c799f2d31c0d2aa6c718ab6e7bf56ad22c33bb17180c4e9'
    '32ed19507385e51a4f8f8dcd4fd655fd4052452ca2e4228e22e7b88a5427ed90'
    '8a481bb98e3e9b0542a0613db36e6409147f9b4d5522e5d58de5a3709d60329d'
    '15c1cc5ba8cecda57e4aee85021bf890d4afb48074b49ea727f903f6d9e51cc2'
)

build() {
    # Arch ships phosh-plugin.h but not status-icon.h. Use the matching upstream
    # release header, not a copied ABI declaration or a shell resource overlay.
    glib-compile-resources --generate-source --target=q25-resources.c q25-keyboard.gresources.xml
    cc -shared -fPIC $CFLAGS -Wall -Wextra -Wno-unused-parameter -Werror \
        -I"phosh-$pkgver/src" $(pkg-config --cflags phosh-plugins gtk+-3.0 gio-unix-2.0) \
        q25-keyboard.c q25-resources.c -o libphosh-plugin-q25-keyboard.so \
        $LDFLAGS $(pkg-config --libs gtk+-3.0 gio-unix-2.0)
}

check() {
    readelf -Ws libphosh-plugin-q25-keyboard.so | grep -q g_io_module_load
    # Plugin resolves the upstream PhoshStatusIcon API from the shell process.
    readelf -Ws libphosh-plugin-q25-keyboard.so | grep -q phosh_status_icon_get_type
}

package() {
    install -Dm755 libphosh-plugin-q25-keyboard.so "$pkgdir/usr/lib/phosh/plugins/libphosh-plugin-q25-keyboard.so"
    install -Dm644 q25-keyboard.plugin "$pkgdir/usr/lib/phosh/plugins/q25-keyboard.plugin"
}
