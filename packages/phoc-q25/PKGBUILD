# SPDX-License-Identifier: GPL-3.0-or-later
# phoc built the way upstream ships it: statically against its *embedded* wlroots
# 0.20.2 with phoc's wlroots patch applied.
#
# Why: Arch Linux ARM's phoc links the stock system wlroots0.20, which lacks phoc's
# "Revert layer-shell: error on 0 dimension without anchors" patch. Phosh 0.57's
# home bar is a bottom/left/right-anchored layer surface with height 0, so stock
# wlroots kills the Phosh client with a protocol error (Error 71) on every start
# and Phosh crash-loops. The embedded, patched wlroots accepts it.
pkgname=phoc-q25
_pkgname=phoc
pkgver=0.57.0
pkgrel=1
pkgdesc='Wayland compositor for mobile phones (with phoc-patched embedded wlroots)'
arch=('aarch64')
url='https://gitlab.gnome.org/World/Phosh/phoc'
license=('GPL-3.0-or-later')
provides=("phoc=$pkgver")
conflicts=('phoc')
depends=('cairo' 'dconf' 'gcc-libs' 'glib2' 'glibc' 'gnome-desktop' 'gsettings-desktop-schemas'
         'hicolor-icon-theme' 'libgmobile' 'libinput' 'libxcb' 'libxkbcommon' 'mutter' 'pango'
         'pixman' 'systemd-libs' 'wayland' 'xorg-xwayland'
         # statically linked wlroots' runtime libraries
         'libdisplay-info' 'libdrm' 'libglvnd' 'lcms2' 'libliftoff' 'seatd' 'vulkan-icd-loader'
         'opengl-driver' 'xcb-util-errors' 'xcb-util-renderutil' 'xcb-util-wm' 'hwdata')
makedepends=('meson' 'ninja' 'gcc' 'pkgconf' 'glib2-devel' 'wayland-protocols' 'glslang'
             'vulkan-headers' 'python-docutils' 'libgmobile' 'mesa')
source=("https://sources.phosh.mobi/releases/phoc/$_pkgname-$pkgver.tar.xz"
        'wlroots-0001-revert-layer-shell-0-dimension-error.patch')
sha256sums=('1f5688e1136b971f6d86cfb49a2fb3f8fbe13bae0f6099258d3a007a2707ee56'
            'db17fba374893d7e00c283dfdaad7abc61170782775c411ab1c79821440ff0a1')

prepare() {
    # the release tarball carries pristine wlroots; Meson only applies wrap
    # diff_files when it downloads the wrap itself, so apply phoc's patch here
    cd "$_pkgname-$pkgver/subprojects/wlroots-0.20.x"
    patch -Np1 -i "$srcdir/wlroots-0001-revert-layer-shell-0-dimension-error.patch"
}

build() {
    arch-meson "$_pkgname-$pkgver" build \
        -Dembed-wlroots=enabled -Dwlroots:default_library=static \
        -Dwlroots:xwayland=enabled -Dxwayland=enabled \
        -Dtests=false -Dman=true
    meson compile -C build
}

check() {
    # the embedded wlroots must have the revert, otherwise Phosh crash-loops
    local bin; bin=$(find build/src -maxdepth 1 -type f -name phoc -perm -u+x)
    [ -n "$bin" ]
    ! grep -q 'height 0 requested without setting top and bottom anchors' "$bin"
    # and phoc must not link the (unpatched) system libwlroots
    ! readelf -d "$bin" | grep -q 'libwlroots'
}

package() {
    meson install -C build --destdir "$pkgdir" --skip-subprojects
}
