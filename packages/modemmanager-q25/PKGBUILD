# SPDX-License-Identifier: GPL-2.0-or-later
pkgname=modemmanager-q25
pkgver=1.24.2
pkgrel=6
pkgdesc='MediaTek CCCI AT/ccmni plugin for the Zinwa Q25 (ModemManager 1.24.2 ABI)'
arch=('aarch64')
url='https://gitlab.freedesktop.org/mobile-broadband/ModemManager'
license=('GPL-2.0-or-later')
depends=('modemmanager=1.24.2' 'libmm-glib=1.24.2')
makedepends=('meson' 'ninja' 'gcc' 'pkgconf' 'libgudev' 'libmbim' 'libqmi'
             'libqrtr-glib' 'systemd' 'patchelf' 'glib2-devel' 'libxslt')
source=("https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/archive/$pkgver/ModemManager-$pkgver.tar.gz"
        'mtk-ccci-meson.patch'
        'mm-plugin-mtk-ccci.c'
        'mm-modem-helpers-mtk-ccci.c'
        'mm-modem-helpers-mtk-ccci.h'
        'mm-ims-observer-mtk-ccci.c'
        'mm-ims-observer-mtk-ccci.h'
        'mm-ims-bridge-mtk-ccci.c'
        'mm-ims-bridge-mtk-ccci.h'
        'test-modem-helpers-mtk-ccci.c'
        'test-ims-observer-mtk-ccci.c'
        '77-mm-mtk-ccci.rules')

prepare() {
    cd "ModemManager-$pkgver"
    patch -Np1 -i "$srcdir/mtk-ccci-meson.patch"
    mkdir -p src/plugins/mtk-ccci
    cp "$srcdir"/mm-*-mtk-ccci.[ch] src/plugins/mtk-ccci/
}

build() {
    meson setup build "ModemManager-$pkgver" --prefix=/usr --libdir=lib \
        --buildtype=release -Dbuiltin_plugins=false -Dintrospection=false \
        -Dgtk_doc=false -Dman=false -Dvapi=false -Dtests=false -Dbash_completion=false
    ninja -C build src/plugins/libmm-plugin-mtk-ccci.so
}

check() {
    cc $CFLAGS $CPPFLAGS -Wall -Wextra -Werror \
        mm-modem-helpers-mtk-ccci.c test-modem-helpers-mtk-ccci.c \
        $(pkg-config --cflags --libs gio-2.0) $LDFLAGS -o test-modem-helpers-mtk-ccci
    ./test-modem-helpers-mtk-ccci
    cc $CFLAGS $CPPFLAGS -Wall -Wextra -Werror \
        -Ibuild/include -I"ModemManager-$pkgver/include" -I"ModemManager-$pkgver/src" \
        mm-modem-helpers-mtk-ccci.c test-ims-observer-mtk-ccci.c \
        $(pkg-config --cflags --libs gio-2.0) $LDFLAGS -o test-ims-observer-mtk-ccci
    ./test-ims-observer-mtk-ccci
}

package() {
    install -Dm755 build/src/plugins/libmm-plugin-mtk-ccci.so \
        "$pkgdir/usr/lib/ModemManager/libmm-plugin-mtk-ccci.so"
    # Only the plugin is shipped. Do not retain Meson's in-tree libmm-glib RPATH.
    patchelf --remove-rpath "$pkgdir/usr/lib/ModemManager/libmm-plugin-mtk-ccci.so"
    install -Dm644 77-mm-mtk-ccci.rules "$pkgdir/usr/lib/udev/rules.d/77-mm-mtk-ccci.rules"
}

