+    async def start_call(self, call):
+        if call.start_attempted:
+            raise DBusError('org.freedesktop.ModemManager1.Error.Core.WrongState', 'Dial already attempted; do not retry an uncertain outcome')
+        if self.pending_call is not None:
+            raise DBusError('org.freedesktop.ModemManager1.Error.Core.InProgress', 'Another Dial is pending')
+        manager = self.ofono_interfaces.get('org.ofono.VoiceCallManager')
+        if manager is None:
+            raise DBusError('org.freedesktop.ModemManager1.Error.Core.WrongState', 'VoiceCallManager is not available')
+        object_path = next(path for path, item in self.calls.items() if item is call)
+        call.start_attempted = True
+        self.pending_call = call
+        try:
+            path = await manager.call_dial(call.props['Number'].value, '')
+            if path in self.call_path_map:
+                raise DBusError('org.freedesktop.ModemManager1.Error.Core.Failed', 'Dial returned an already mapped path')
+            call.voicecall = path
+            if path in self.pending_removed:
+                call.property_changed('State', Variant('s', 'disconnected'))
+            else:
+                self.call_path_map[path] = object_path
+                call.init_call()
+                call.property_changed('State', Variant('s', 'dialing'))
+                props = self.pending_call_events.pop(path, {})
+                for name in ('State', 'Multiparty'):
+                    if name in props:
+                        call.property_changed(name, props[name])
+        except Exception:
+            # Without a returned path, do not guess which CallAdded was ours.
+            # Retire the unbound draft; observed native calls are exported below
+            # as separate discoveries, without a duplicate draft or another Dial.
+            if call.voicecall == '/':
+                call.deleted = True
+                self.calls.pop(object_path, None)
+                self.props['Calls'].value.remove(object_path)
+                self.bus.unexport(object_path)
+                self.emit_properties_changed({'Calls': self.props['Calls'].value})
+                self.CallDeleted(object_path)
+            raise DBusError('org.freedesktop.ModemManager1.Error.Core.Failed', 'Dial failed or outcome unknown; not retried') from None
+        finally:
+            self.pending_call = None
+            events = self.pending_call_events
+            self.pending_call_events = {}
+            self.pending_removed.clear()
+            for path, props in events.items():
