# Offline review artifact only: no activation/configuration/install hooks.
pkgname=ofono2mm-furilabs-inert
pkgver=1.24.0.r82d43ea
pkgrel=3
pkgdesc='FuriLabs oFono2MM with deferred send/dial and diagnostic mode; inert review build'
arch=('any')
url='https://github.com/FuriLabs/oFono2MM'
license=('BSD-3-Clause')
depends=('python' 'python-dbus-fast' 'python-dbus' 'python-gobject' 'geoclue')
makedepends=('patch')
checkdepends=('dbus')
conflicts=('ofono2mm' 'ofono2mm-inert')
options=('!strip' '!debug')
_pin=82d43ea178977ee2bf90baa202720413d39a691e
_tree="furilabs-ofono2mm-${_pin}"
source=("${_tree}.tar.gz"
        '0001-defer-sms.patch'
        '0002-diagnostic-no-autoactivation.patch'
        '0003-defer-voice.patch'
        '0004-metadata-only-logging.patch'
        '0005-reconcile-native-sms-state.patch'
        '0006-idempotent-call-delete.patch'
        '0007-sms-observer-lifecycle.patch'
        'test_contract.py')
sha256sums=('ab47999fc40b5bfe8d98c4248ac7e2aede63a49841320ecba3c1e9538476851b'
            'de4e2e097f6e1ecc04ef9a955e187d3cb52c6c823e41a26a601806fdf6ba9677'
            'e3284e6882c2394772e22ec626d78aa3ecb5f1a885f2435b0c892f66999abb36'
            '561d63235bf9427667017ad01d0abd3ded5eb44e81bb13ce83622b2004cbea6a'
            'c86a9b6a5df3cf9d67c230ced6b27a23ab372a47202fd19a0f599147bb23639e'
            '229600f778a25c3d49ec39b7d06dfd6ada7c5c52ea24400b871deb9b34298731'
            'd9636de96c11f29137eaccc574d4e89ceb7ad72debe568b1dd4df2455e918990'
            'f1925c191d5f6b3c539ef7c3fbfa649842a2c9bc65e36fcb056b84bfd08bdb65'
            '478c0febed574cc25c385931721cd81c329c33b7fcc8b70c6edcf0eae4c3e9ee')

prepare() {
    cd "$srcdir/$_tree"
    local change
    for change in "$srcdir"/000*.patch; do
        patch --batch --fuzz=0 -Np1 -i "$change"
    done
}

check() {
    OFONO2MM_SOURCE="$srcdir/$_tree" python "$srcdir/test_contract.py"
}

package() {
    local tree="$srcdir/$_tree"
    # Deliberately do NOT use upstream make install.
    install -Dm644 "$tree/main.py" "$pkgdir/usr/lib/ofono2mm/main.py"
    install -d "$pkgdir/usr/lib/ofono2mm/ofono2mm"
    install -m644 "$tree"/ofono2mm/*.py "$pkgdir/usr/lib/ofono2mm/ofono2mm/"
    install -m644 "$tree"/dbus/*.xml "$pkgdir/usr/lib/ofono2mm/"
    install -Dm644 "$tree/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # No launcher, ofonoctl, systemd, polkit, NM configuration or bus policy.
}
