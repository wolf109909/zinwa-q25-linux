diff --git a/src/binder_sms_pdu.c b/src/binder_sms_pdu.c
new file mode 100644
index 0000000..2c03c9d
--- /dev/null
+++ b/src/binder_sms_pdu.c
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "binder_sms_pdu.h"
+
+/* Keep binary SMSC bytes, including embedded zeroes and the length octet,
+ * until encoding. A C-string copy of the original PDU loses that information. */
+gboolean
+binder_sms_prepare_ext_pdu(
+    const guint8* pdu,
+    int pdu_len,
+    int tpdu_len,
+    gboolean smsc_hex,
+    const guint8** tpdu,
+    char** smsc)
+{
+    int smsc_len;
+
+    *tpdu = NULL;
+    *smsc = NULL;
+    if (!pdu || tpdu_len <= 0 || tpdu_len > BINDER_SMS_MAX_TPDU_LEN ||
+        pdu_len < tpdu_len ||
+        pdu_len > BINDER_SMS_MAX_TPDU_LEN + BINDER_SMS_MAX_SMSC_LEN) {
+        return FALSE;
+    }
+    smsc_len = pdu_len - tpdu_len;
+    if (smsc_len > BINDER_SMS_MAX_SMSC_LEN ||
+        (smsc_len && pdu[0] + 1 != smsc_len)) {
+        return FALSE;
+    }
+    if (smsc_len > 1) {
+        if (smsc_hex) {
+            static const char hex[] = "0123456789ABCDEF";
+            char* encoded = g_malloc(2 * smsc_len + 1);
+            int i;
+
+            for (i = 0; i < smsc_len; i++) {
+                encoded[2 * i] = hex[pdu[i] >> 4];
+                encoded[2 * i + 1] = hex[pdu[i] & 15];
+            }
+            encoded[2 * smsc_len] = 0;
+            *smsc = encoded;
+        } else {
+            /* Preserve the existing representation for unflagged plugins. */
+            *smsc = g_strndup((const char*)pdu, smsc_len);
+        }
+    }
+    *tpdu = pdu + smsc_len;
+    return TRUE;
+}
diff --git a/src/binder_sms_pdu.h b/src/binder_sms_pdu.h
new file mode 100644
index 0000000..c55f924
--- /dev/null
+++ b/src/binder_sms_pdu.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef BINDER_SMS_PDU_H
+#define BINDER_SMS_PDU_H
+
+#include <glib.h>
+
+/* oFono sms_encode() documents 164 TPDU + 12 SMSC bytes. */
+#define BINDER_SMS_MAX_TPDU_LEN 164
+#define BINDER_SMS_MAX_SMSC_LEN 12
+
+/* Split a binary PDU using its explicit lengths. The TPDU is borrowed;
+ * SMSC is an owned string (NULL for default), hex only for opted-in clients. */
+gboolean binder_sms_prepare_ext_pdu(const guint8* pdu, int pdu_len,
+    int tpdu_len, gboolean smsc_hex, const guint8** tpdu, char** smsc);
+
+#endif /* BINDER_SMS_PDU_H */
diff --git a/unit/unit_sms_pdu/Makefile b/unit/unit_sms_pdu/Makefile
new file mode 100644
index 0000000..6751df9
--- /dev/null
+++ b/unit/unit_sms_pdu/Makefile
@@ -0,0 +1,19 @@
+# Pure byte/string tests; deliberately independent of the daemon/Binder runtime.
+CC ?= cc
+CPPFLAGS += -I../../src $(shell pkg-config --cflags glib-2.0)
+CFLAGS += -std=gnu11 -g -Wall -Wextra
+LDLIBS = $(shell pkg-config --libs glib-2.0)
+BUILD ?= build
+
+.PHONY: all debug release test test-debug test-release clean unitclean
+all debug release: $(BUILD)/unit_sms_pdu
+
+test test-debug test-release: $(BUILD)/unit_sms_pdu
+	$(BUILD)/unit_sms_pdu
+
+$(BUILD)/unit_sms_pdu: unit_sms_pdu.c ../../src/binder_sms_pdu.c ../../src/binder_sms_pdu.h
+	mkdir -p $(BUILD)
+	$(CC) $(CPPFLAGS) $(CFLAGS) unit_sms_pdu.c ../../src/binder_sms_pdu.c $(LDFLAGS) $(LDLIBS) -o $@
+
+clean unitclean:
+	rm -rf $(BUILD)
diff --git a/unit/unit_sms_pdu/unit_sms_pdu.c b/unit/unit_sms_pdu/unit_sms_pdu.c
new file mode 100644
index 0000000..d128e2e
--- /dev/null
+++ b/unit/unit_sms_pdu/unit_sms_pdu.c
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "binder_sms_pdu.h"
+#include <string.h>
+
+static void test_split_hex(void)
+{
+    const guint8 pdu[] = { 3, 0x91, 0, 0xf1, 0x01, 0, 0xff };
+    const guint8 expected_tpdu[] = { 0x01, 0, 0xff };
+    const guint8* tpdu;
+    char* smsc;
+
+    g_assert_true(binder_sms_prepare_ext_pdu(pdu, sizeof(pdu),
+        sizeof(expected_tpdu), TRUE, &tpdu, &smsc));
+    g_assert_cmpstr(smsc, ==, "039100F1");
+    g_assert_true(tpdu == pdu + 4);
+    g_assert_cmpmem(tpdu, sizeof(expected_tpdu), expected_tpdu, sizeof(expected_tpdu));
+    g_free(smsc);
+}
+
+static void test_default(void)
+{
+    const guint8 pdu[] = { 0, 0x01, 0, 0xff };
+    const guint8* tpdu;
+    char* smsc;
+
+    for (guint hex = 0; hex < 2; hex++) {
+        g_assert_true(binder_sms_prepare_ext_pdu(pdu, sizeof(pdu), 3,
+            hex, &tpdu, &smsc));
+        g_assert_null(smsc);
+        g_assert_true(tpdu == pdu + 1);
+        /* The pre-existing no-prefix case also selects the default SMSC. */
+        g_assert_true(binder_sms_prepare_ext_pdu(pdu + 1, 3, 3,
+            hex, &tpdu, &smsc));
+        g_assert_null(smsc);
+        g_assert_true(tpdu == pdu + 1);
+    }
+}
+
+static void test_legacy(void)
+{
+    const guint8 pdu[] = { 3, 0x91, 0, 0xf1, 0x01 };
+    const guint8* tpdu;
+    char* smsc;
+
+    g_assert_true(binder_sms_prepare_ext_pdu(pdu, sizeof(pdu), 1,
+        FALSE, &tpdu, &smsc));
+    /* Unflagged plugins keep the old string, including its truncation. */
+    g_assert_cmpuint(strlen(smsc), ==, 2);
+    g_assert_cmpmem(smsc, 2, pdu, 2);
+    g_assert_true(tpdu == pdu + 4);
+    g_free(smsc);
+}
+
+static void test_lengths(void)
+{
+    guint8 pdu[BINDER_SMS_MAX_SMSC_LEN + BINDER_SMS_MAX_TPDU_LEN];
+    const guint8* tpdu;
+    char* smsc;
+
+    for (guint len = 2; len <= BINDER_SMS_MAX_SMSC_LEN; len++) {
+        memset(pdu, 0xff, sizeof(pdu));
+        pdu[0] = len - 1;
+        pdu[1] = 0x91;
+        g_assert_true(binder_sms_prepare_ext_pdu(pdu,
+            len + BINDER_SMS_MAX_TPDU_LEN, BINDER_SMS_MAX_TPDU_LEN,
+            TRUE, &tpdu, &smsc));
+        g_assert_cmpuint(strlen(smsc), ==, 2 * len);
+        g_assert_cmpint(g_ascii_xdigit_value(smsc[0]) * 16 +
+            g_ascii_xdigit_value(smsc[1]), ==, len - 1);
+        g_assert_cmpmem(smsc + 2, 2, "91", 2);
+        g_assert_true(tpdu == pdu + len);
+        for (guint i = 0; i < BINDER_SMS_MAX_TPDU_LEN; i++) {
+            g_assert_cmpuint(tpdu[i], ==, 0xff);
+        }
+        g_free(smsc);
+    }
+}
+
+static void test_invalid(void)
+{
+    const guint8 pdu[] = { 3, 0x91, 0, 0xf1, 1 };
+    const guint8 truncated[] = { 4, 0x91, 0, 0xf1, 1 };
+    const guint8 inconsistent_default[] = { 1, 1 };
+    const struct { const guint8* pdu; int len; int tpdu_len; } cases[] = {
+        { NULL, 0, 0 }, { NULL, 1, 1 }, { pdu, 0, 0 },
+        { pdu, -1, 1 }, { pdu, 1, -1 }, { pdu, 1, 2 },
+        { pdu, 1, 0 }, { pdu, G_MAXINT, 1 }, { pdu, G_MAXINT, G_MAXINT },
+        { pdu, 177, 164 }, { pdu, 166, 165 }, { pdu, 14, 1 },
+        { truncated, sizeof(truncated), 1 },
+        { inconsistent_default, sizeof(inconsistent_default), 1 },
+        { pdu, sizeof(pdu), 2 }
+    };
+    for (guint hex = 0; hex < 2; hex++) {
+        for (guint i = 0; i < G_N_ELEMENTS(cases); i++) {
+            const guint8* tpdu = (const guint8*)1;
+            char* smsc = (char*)1;
+            g_assert_false(binder_sms_prepare_ext_pdu(cases[i].pdu,
+                cases[i].len, cases[i].tpdu_len, hex, &tpdu, &smsc));
+            g_assert_null(tpdu);
+            g_assert_null(smsc);
+        }
+    }
+}
+
+int main(int argc, char** argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/binder-sms-pdu/hex-embedded-zero", test_split_hex);
+    g_test_add_func("/binder-sms-pdu/default", test_default);
+    g_test_add_func("/binder-sms-pdu/legacy", test_legacy);
+    g_test_add_func("/binder-sms-pdu/lengths", test_lengths);
+    g_test_add_func("/binder-sms-pdu/invalid", test_invalid);
+    return g_test_run();
+}
