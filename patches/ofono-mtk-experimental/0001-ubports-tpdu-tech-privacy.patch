+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ *  This program is distributed in the hope that it will be useful,
+ *  but WITHOUT ANY WARRANTY; without even the implied warranty of
+ *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ *  GNU General Public License for more details.
+ */
+
+#include "mtk_sms.h"
+#include "binder_util.h"
+
+char*
+mtk_sms_encode_tpdu(
+    const void* tpdu,
+    gsize tpdu_len)
+{
+    static const char hex[] = "0123456789ABCDEF";
+    const guint8* bytes = tpdu;
+    char* encoded;
+    gsize i;
+
+    if (!tpdu || !tpdu_len || tpdu_len > MTK_SMS_MAX_TPDU_LEN) {
+        return NULL;
+    }
+    encoded = g_malloc(2 * tpdu_len + 1);
+    for (i = 0; i < tpdu_len; i++) {
+        encoded[2 * i] = hex[bytes[i] >> 4];
+        encoded[2 * i + 1] = hex[bytes[i] & 15];
+    }
+    encoded[2 * tpdu_len] = 0;
+    return encoded;
+}
+
+static void
+mtk_ims_sms_gsm_message(
+    GBinderWriter* writer,
+    RadioGsmSmsMessage* msg,
+    const char* smsc,
+    const char* tpdu,
+    const GBinderParent* parent)
+{
+    guint msg_index;
+
+    binder_copy_hidl_string(writer, &msg->smscPdu, smsc);
+
+    binder_copy_hidl_string(writer, &msg->pdu, tpdu);
+
+    msg_index = gbinder_writer_append_buffer_object_with_parent(writer,
+        msg, sizeof(*msg), parent);
+    binder_append_hidl_string_data(writer, msg, smscPdu, msg_index);
+    binder_append_hidl_string_data(writer, msg, pdu, msg_index);
+}
+
+void
+mtk_sms_write_hidl(
+    GBinderWriter* writer,
+    const char* smsc,
+    const char* tpdu)
+{
+    RadioImsSmsMessage* ims = gbinder_writer_new0(writer, RadioImsSmsMessage);
+    RadioGsmSmsMessage* gsm = gbinder_writer_new0(writer, RadioGsmSmsMessage);
+    GBinderParent parent;
+
+    ims->tech = RADIO_TECH_FAMILY_3GPP;
+    ims->gsmMessage.count = 1;
+    ims->gsmMessage.data.ptr = gsm;
+    ims->gsmMessage.owns_buffer = TRUE;
+
+    parent.index = gbinder_writer_append_buffer_object(writer, ims, sizeof(*ims));
+    parent.offset = G_STRUCT_OFFSET(RadioImsSmsMessage, cdmaMessage.data.ptr);
+    gbinder_writer_append_buffer_object_with_parent(writer, NULL, 0, &parent);
+
+    parent.offset = G_STRUCT_OFFSET(RadioImsSmsMessage, gsmMessage.data.ptr);
+    mtk_ims_sms_gsm_message(writer, gsm, smsc, tpdu, &parent);
+}
+
+void
+mtk_sms_write_aidl(
+    GBinderWriter* writer,
+    const char* smsc,
+    const char* tpdu)
+{
+    gint32 ims_initial_size;
+    gint32 gsm_initial_size;
+    const gint32 tech = RADIO_TECH_FAMILY_3GPP;
+    const gboolean retry = FALSE;
+    const gint32 message_ref = 0;
+
+    gbinder_writer_append_int32(writer, 1);
+    ims_initial_size = gbinder_writer_bytes_written(writer);
+    gbinder_writer_append_int32(writer, -1);
+
+    gbinder_writer_append_int32(writer, tech);
+    gbinder_writer_append_bool(writer, retry);
+    gbinder_writer_append_int32(writer, message_ref);
+
+    gbinder_writer_append_int32(writer, 0);
+    gbinder_writer_append_int32(writer, 1);
+
+    gbinder_writer_append_int32(writer, 1);
+    gsm_initial_size = gbinder_writer_bytes_written(writer);
+    gbinder_writer_append_int32(writer, -1);
+
+    gbinder_writer_append_string16(writer, smsc ? smsc : "");
+    gbinder_writer_append_string16(writer, tpdu);
+
+    gbinder_writer_overwrite_int32(writer, gsm_initial_size,
+        gbinder_writer_bytes_written(writer) - gsm_initial_size);
+    gbinder_writer_overwrite_int32(writer, ims_initial_size,
+        gbinder_writer_bytes_written(writer) - ims_initial_size);
+}
diff --git a/src/mtk_sms.h b/src/mtk_sms.h
new file mode 100644
index 0000000..6896403
--- /dev/null
+++ b/src/mtk_sms.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MTK_SMS_H
+#define MTK_SMS_H
+
+#include <gbinder.h>
+
+/* oFono sms_encode(): at most 164 TPDU bytes, excluding the SMSC. */
+#define MTK_SMS_MAX_TPDU_LEN 164
+
+/* Binary TPDU only; no SMSC prefix. Returns owned uppercase hex, or NULL. */
+char* mtk_sms_encode_tpdu(const void* tpdu, gsize tpdu_len);
+
+/* Both strings are separate hex PDUs; NULL SMSC selects the HAL default. */
+void mtk_sms_write_hidl(GBinderWriter* writer, const char* smsc,
+    const char* tpdu);
+void mtk_sms_write_aidl(GBinderWriter* writer, const char* smsc,
+    const char* tpdu);
+
+#endif /* MTK_SMS_H */
diff --git a/tests/Makefile b/tests/Makefile
new file mode 100644
index 0000000..cca7518
--- /dev/null
+++ b/tests/Makefile
@@ -0,0 +1,20 @@
+# Synthetic writer capture only: no Binder library, modem or service is used.
+CC ?= cc
+PKGS = glib-2.0 libgbinder libgbinder-radio
+CPPFLAGS += -I../src $(shell pkg-config --cflags $(PKGS))
+CFLAGS += -std=gnu11 -g -Wall -ffunction-sections -fdata-sections
+LDLIBS = $(shell pkg-config --libs glib-2.0)
+LDFLAGS += -Wl,--gc-sections
+BUILD ?= ../build/tests
+
+.PHONY: test clean
+
+test: $(BUILD)/test_mtk_sms
+	$(BUILD)/test_mtk_sms
+
+$(BUILD)/test_mtk_sms: test_mtk_sms.c ../src/mtk_sms.c ../src/mtk_sms.h ../src/binder_util.c
+	mkdir -p $(BUILD)
+	$(CC) $(CPPFLAGS) $(CFLAGS) test_mtk_sms.c ../src/mtk_sms.c ../src/binder_util.c $(LDFLAGS) $(LDLIBS) -o $@
+
+clean:
+	rm -rf $(BUILD)
diff --git a/tests/README.md b/tests/README.md
new file mode 100644
index 0000000..bdb056b
--- /dev/null
+++ b/tests/README.md
@@ -0,0 +1,17 @@
+# Offline SMS contract tests
+
+`make -C tests test` uses GLib and the project's existing development headers.
+It links the production TPDU encoder, extracted HIDL/AIDL SMS writers and
+production HIDL string-copy helpers against writer-call capture mocks, **not**
+libgbinder. No service manager, device, socket, Binder transaction or SMS send is
+created. This verifies writer arguments/parent relationships, not actual HAL
+acceptance or the complete libgbinder wire representation.
+
+The one-byte test vector exercises the encoder boundary; it is deliberately not
+a claim that a one-byte TPDU is a valid SMS. The 164-byte limit follows the
+upstream oFono `sms_encode()` buffer contract (164 TPDU + 12 SMSC bytes).
+Retry, message-reference and acknowledgment behavior is unchanged.
+
+The standalone TPDU/technology/privacy patch rejects non-null SMSC at the
+extension entry point until the separately reviewed caller encoding patch is
+applied. This is an experimental branch, not a deployable/no-send policy.
diff --git a/tests/test_mtk_sms.c b/tests/test_mtk_sms.c
new file mode 100644
index 0000000..4d53c9f
--- /dev/null
+++ b/tests/test_mtk_sms.c
@@ -0,0 +1,229 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "mtk_sms.h"
+#include <radio_types.h>
+#include <string.h>
+
+/* Capture writer API calls, not Binder wire bytes. No libgbinder is linked. */
+typedef struct buffer_call {
+    const void* data;
+    gsize size;
+    GBinderParent parent;
+    gboolean has_parent;
+} BufferCall;
+
+typedef struct mock_writer {
+    GPtrArray* allocations;
+    GArray* buffers;
+    GArray* integers;
+    GPtrArray* strings;
+    GArray* patches;
+    guint bytes;
+} MockWriter;
+
+static MockWriter* mock(GBinderWriter* writer)
+{
+    return (MockWriter*)writer->d[0];
+}
+
+static void writer_init(GBinderWriter* writer, MockWriter* state)
+{
+    memset(writer, 0, sizeof(*writer));
+    memset(state, 0, sizeof(*state));
+    writer->d[0] = state;
+    state->allocations = g_ptr_array_new_with_free_func(g_free);
+    state->buffers = g_array_new(FALSE, FALSE, sizeof(BufferCall));
+    state->integers = g_array_new(FALSE, FALSE, sizeof(guint32));
+    state->strings = g_ptr_array_new_with_free_func(g_free);
+    state->patches = g_array_new(FALSE, FALSE, sizeof(guint32));
+}
+
+static void writer_clear(MockWriter* state)
+{
+    g_ptr_array_unref(state->allocations);
+    g_array_unref(state->buffers);
+    g_array_unref(state->integers);
+    g_ptr_array_unref(state->strings);
+    g_array_unref(state->patches);
+}
+
+void* gbinder_writer_malloc(GBinderWriter* writer, gsize size)
+{
+    void* data = g_malloc(size);
+    g_ptr_array_add(mock(writer)->allocations, data);
+    return data;
+}
+
+void* gbinder_writer_malloc0(GBinderWriter* writer, gsize size)
+{
+    return memset(gbinder_writer_malloc(writer, size), 0, size);
+}
+
+void* gbinder_writer_memdup(GBinderWriter* writer, const void* data, gsize size)
+{
+    return memcpy(gbinder_writer_malloc(writer, size), data, size);
+}
+
+guint gbinder_writer_append_buffer_object_with_parent(GBinderWriter* writer,
+    const void* data, gsize size, const GBinderParent* parent)
+{
+    BufferCall call = { .data = data, .size = size, .has_parent = parent != NULL };
+    guint index = mock(writer)->buffers->len;
+    if (parent) call.parent = *parent;
+    g_array_append_val(mock(writer)->buffers, call);
+    return index;
+}
+
+guint gbinder_writer_append_buffer_object(GBinderWriter* writer,
+    const void* data, gsize size)
+{
+    return gbinder_writer_append_buffer_object_with_parent(writer, data, size, NULL);
+}
+
+void gbinder_writer_append_int32(GBinderWriter* writer, guint32 value)
+{
+    g_array_append_val(mock(writer)->integers, value);
+    mock(writer)->bytes += 4;
+}
+
+void gbinder_writer_append_bool(GBinderWriter* writer, gboolean value)
+{
+    gbinder_writer_append_int32(writer, value);
+}
+
+void gbinder_writer_append_string16(GBinderWriter* writer, const char* value)
+{
+    g_assert_nonnull(value);
+    g_ptr_array_add(mock(writer)->strings, g_strdup(value));
+    mock(writer)->bytes += 4 + ((2 * (strlen(value) + 1) + 3) & ~3);
+}
+
+gsize gbinder_writer_bytes_written(GBinderWriter* writer)
+{
+    return ((const MockWriter*)writer->d[0])->bytes;
+}
+
+void gbinder_writer_overwrite_int32(GBinderWriter* writer, gsize offset,
+    gint32 value)
+{
+    guint32 at = offset;
+    g_array_append_val(mock(writer)->patches, at);
+    g_array_append_val(mock(writer)->patches, value);
+}
+
+static void test_tpdu_boundaries(void)
+{
+    const guint8 tiny[] = { 0xab };
+    const guint8 binary[] = { 0x00, 0x80, 0xff, 0x01 };
+    guint8 maximum[MTK_SMS_MAX_TPDU_LEN];
+    char* hex;
+
+    g_assert_null(mtk_sms_encode_tpdu(NULL, 0));
+    g_assert_null(mtk_sms_encode_tpdu(NULL, 1));
+    g_assert_null(mtk_sms_encode_tpdu(tiny, 0));
+    g_assert_null(mtk_sms_encode_tpdu(tiny, MTK_SMS_MAX_TPDU_LEN + 1));
+    g_assert_null(mtk_sms_encode_tpdu(tiny, G_MAXINT));
+    g_assert_null(mtk_sms_encode_tpdu(tiny, G_MAXSIZE));
+    hex = mtk_sms_encode_tpdu(tiny, sizeof(tiny));
+    g_assert_cmpstr(hex, ==, "AB");
+    g_free(hex);
+    hex = mtk_sms_encode_tpdu(binary, sizeof(binary));
+    g_assert_cmpstr(hex, ==, "0080FF01");
+    g_free(hex);
+    memset(maximum, 0xa5, sizeof(maximum));
+    hex = mtk_sms_encode_tpdu(maximum, sizeof(maximum));
+    g_assert_cmpuint(strlen(hex), ==, 2 * sizeof(maximum));
+    for (guint i = 0; i < sizeof(maximum); i++) {
+        g_assert_cmpint(hex[2 * i], ==, 'A');
+        g_assert_cmpint(hex[2 * i + 1], ==, '5');
+    }
+    g_free(hex);
+}
+
+static void test_hidl_writer(void)
+{
+    const char* smscs[] = { NULL, "", "0191", "039100F1", "0B910080AABBCCDDEEFF0011" };
+    const guint8 bytes[] = { 0x00, 0x80, 0xff, 0x01 };
+    char* tpdu = mtk_sms_encode_tpdu(bytes, sizeof(bytes));
+
+    for (guint i = 0; i < G_N_ELEMENTS(smscs); i++) {
+        GBinderWriter writer;
+        MockWriter state;
+        const RadioImsSmsMessage* ims;
+        const RadioGsmSmsMessage* gsm;
+        BufferCall call;
+
+        writer_init(&writer, &state);
+        mtk_sms_write_hidl(&writer, smscs[i], tpdu);
+        g_assert_cmpuint(state.buffers->len, ==, 5);
+        call = g_array_index(state.buffers, BufferCall, 0);
+        g_assert_false(call.has_parent);
+        g_assert_cmpuint(call.size, ==, sizeof(*ims));
+        ims = call.data;
+        g_assert_cmpint(ims->tech, ==, RADIO_TECH_FAMILY_3GPP);
+        g_assert_cmpuint(ims->cdmaMessage.count, ==, 0);
+        g_assert_cmpuint(ims->gsmMessage.count, ==, 1);
+        g_assert_false(ims->retry);
+        g_assert_cmpint(ims->messageRef, ==, 0);
+        call = g_array_index(state.buffers, BufferCall, 1);
+        g_assert_null(call.data);
+        g_assert_cmpuint(call.size, ==, 0);
+        g_assert_cmpuint(call.parent.index, ==, 0);
+        g_assert_cmpuint(call.parent.offset, ==, G_STRUCT_OFFSET(RadioImsSmsMessage, cdmaMessage.data.ptr));
+        call = g_array_index(state.buffers, BufferCall, 2);
+        g_assert_cmpuint(call.parent.index, ==, 0);
+        g_assert_cmpuint(call.parent.offset, ==, G_STRUCT_OFFSET(RadioImsSmsMessage, gsmMessage.data.ptr));
+        gsm = call.data;
+        g_assert_true(ims->gsmMessage.data.ptr == gsm);
+        g_assert_cmpstr(gsm->smscPdu.data.str, ==, smscs[i] ? smscs[i] : "");
+        g_assert_cmpuint(gsm->smscPdu.len, ==, smscs[i] ? strlen(smscs[i]) : 0);
+        g_assert_cmpstr(gsm->pdu.data.str, ==, "0080FF01");
+        g_assert_cmpuint(gsm->pdu.len, ==, 8);
+        for (guint j = 3; j < 5; j++) {
+            const GBinderHidlString* str = j == 3 ? &gsm->smscPdu : &gsm->pdu;
+            call = g_array_index(state.buffers, BufferCall, j);
+            g_assert_cmpuint(call.parent.index, ==, 2);
+            g_assert_cmpuint(call.parent.offset, ==, j == 3 ?
+                G_STRUCT_OFFSET(RadioGsmSmsMessage, smscPdu.data.str) :
+                G_STRUCT_OFFSET(RadioGsmSmsMessage, pdu.data.str));
+            g_assert_true(call.data == str->data.str);
+            g_assert_cmpuint(call.size, ==, str->len + 1);
+        }
+        writer_clear(&state);
+    }
+    g_free(tpdu);
+}
+
+static void test_aidl_writer(void)
+{
+    const char* smscs[] = { NULL, "", "0191", "039100F1", "0B910080AABBCCDDEEFF0011" };
+    const guint8 byte[] = { 0xff };
+    char* tpdu = mtk_sms_encode_tpdu(byte, sizeof(byte));
+    const guint32 expected[] = { 1, (guint32)-1, RADIO_TECH_FAMILY_3GPP, FALSE, 0, 0, 1, 1, (guint32)-1 };
+
+    for (guint i = 0; i < G_N_ELEMENTS(smscs); i++) {
+        GBinderWriter writer;
+        MockWriter state;
+        writer_init(&writer, &state);
+        mtk_sms_write_aidl(&writer, smscs[i], tpdu);
+        g_assert_cmpmem(state.integers->data, state.integers->len * sizeof(guint32), expected, sizeof(expected));
+        g_assert_cmpuint(state.strings->len, ==, 2);
+        g_assert_cmpstr(g_ptr_array_index(state.strings, 0), ==, smscs[i] ? smscs[i] : "");
+        g_assert_cmpstr(g_ptr_array_index(state.strings, 1), ==, "FF");
+        g_assert_cmpuint(state.patches->len, ==, 4);
+        g_assert_cmpuint(g_array_index(state.patches, guint32, 0), ==, 32);
+        g_assert_cmpuint(g_array_index(state.patches, guint32, 1), ==, state.bytes - 32);
+        g_assert_cmpuint(g_array_index(state.patches, guint32, 2), ==, 4);
+        g_assert_cmpuint(g_array_index(state.patches, guint32, 3), ==, state.bytes - 4);
+        writer_clear(&state);
+    }
+    g_free(tpdu);
+}
+
+int main(int argc, char** argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/mtk-sms/tpdu-boundaries", test_tpdu_boundaries);
+    g_test_add_func("/mtk-sms/hidl-writer", test_hidl_writer);
+    g_test_add_func("/mtk-sms/aidl-writer", test_aidl_writer);
+    return g_test_run();
+}
