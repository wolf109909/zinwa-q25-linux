index 0000000..e9256ed
--- /dev/null
+++ b/src/mtk_sms.c
@@ -0,0 +1,121 @@
+/*
+ *  oFono - Open Source Telephony - binder based adaptation MTK plugin
+ *
+ *  Copyright (C) 2022 Jolla Ltd.
+ *  Copyright (C) 2024 Furi Labs
+ *  Copyright (C) 2024 Bardia Moshiri <bardia@furilabs.com>
