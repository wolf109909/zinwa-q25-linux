diff --git a/src/mtk_sms.c b/src/mtk_sms.c
index e9256ed..e834f5d 100644
--- a/src/mtk_sms.c
+++ b/src/mtk_sms.c
@@ -19,6 +19,27 @@
 #include "mtk_sms.h"
 #include "binder_util.h"
 
+gboolean
+mtk_sms_smsc_valid(
+    const char* smsc)
+{
+    gsize len = 0;
+
+    if (!smsc || !smsc[0]) {
+        return TRUE;
+    }
+    while (len <= 2 * MTK_SMS_MAX_SMSC_LEN && smsc[len]) {
+        if (!g_ascii_isxdigit(smsc[len])) {
+            return FALSE;
+        }
+        len++;
+    }
+    /* A non-default SMSC has a length octet followed by its address bytes. */
+    return len >= 4 && len <= 2 * MTK_SMS_MAX_SMSC_LEN && !(len & 1) &&
+        (((g_ascii_xdigit_value(smsc[0]) << 4) |
+           g_ascii_xdigit_value(smsc[1])) + 1 == len / 2);
+}
+
 char*
 mtk_sms_encode_tpdu(
     const void* tpdu,
