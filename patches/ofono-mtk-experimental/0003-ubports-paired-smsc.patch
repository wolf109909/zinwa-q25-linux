 }
 
+#ifdef MTK_SMS_PAIRED_CORE
+static void test_paired_core(void)
+{
+    /* Synthetic SMSC bytes and TPDU: no addresses or message contents. */
+    const guint8 pdu[] = { 3, 0x91, 0, 0xf1, 0x01, 0, 0xff };
+    const guint8* binary_tpdu;
+    char* smsc;
+    char* tpdu;
+    GBinderWriter writer;
+    MockWriter state;
+    const RadioGsmSmsMessage* gsm;
+
+    g_assert_true(binder_sms_prepare_ext_pdu(pdu, sizeof(pdu), 3,
+        TRUE, &binary_tpdu, &smsc));
+    g_assert_true(mtk_sms_smsc_valid(smsc));
+    tpdu = mtk_sms_encode_tpdu(binary_tpdu, 3);
+    writer_init(&writer, &state);
+    mtk_sms_write_hidl(&writer, smsc, tpdu);
+    gsm = g_array_index(state.buffers, BufferCall, 2).data;
+    g_assert_true(gsm->smscPdu.data.str != smsc);
+    g_assert_true(gsm->pdu.data.str != tpdu);
+    g_free(tpdu);
+    g_free(smsc);
+    g_assert_cmpstr(gsm->smscPdu.data.str, ==, "039100F1");
+    g_assert_cmpstr(gsm->pdu.data.str, ==, "0100FF");
+    writer_clear(&state);
+    g_assert_true(binder_sms_prepare_ext_pdu(pdu, sizeof(pdu), 3,
+        TRUE, &binary_tpdu, &smsc));
+    tpdu = mtk_sms_encode_tpdu(binary_tpdu, 3);
+    writer_init(&writer, &state);
+    mtk_sms_write_aidl(&writer, smsc, tpdu);
+    g_assert_cmpstr(g_ptr_array_index(state.strings, 0), ==, "039100F1");
+    g_assert_cmpstr(g_ptr_array_index(state.strings, 1), ==, "0100FF");
+    writer_clear(&state);
+    g_free(tpdu);
+    g_free(smsc);
+}
+#endif
