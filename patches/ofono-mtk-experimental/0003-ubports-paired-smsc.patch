+static void test_smsc_contract(void)
+{
+    const char* valid[] = { NULL, "", "0191", "039100F1", "039100f1",
+        "0B910080AABBCCDDEEFF0011" };
+    const char* invalid[] = { "0", "00", "019", "019X", "0291", "0091",
+        "039100", "039100F100", "0C910080AABBCCDDEEFF001122",
+        " 0191", "\003\221", "\003\221\000\361", "é" };
+    for (guint i = 0; i < G_N_ELEMENTS(valid); i++) {
+        g_assert_true(mtk_sms_smsc_valid(valid[i]));
+    }
+    for (guint i = 0; i < G_N_ELEMENTS(invalid); i++) {
+        g_assert_false(mtk_sms_smsc_valid(invalid[i]));
+    }
+}
