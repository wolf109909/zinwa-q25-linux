From: Zinwa Q25 port <noreply@anthropic.com>
Subject: [PATCH] phy: mediatek: tphy: force all u2 session signals on mobile SoCs

Patch 0019 forces AVALID/VBUSVALID/SESSEND only. The vendor driver forces
BVALID and IDPULLUP as well (device 0x3f2f / host 0x3f2d); without a forced
BVALID a device session cannot start once the bootloader's value is gone.

---
diff --git a/drivers/phy/mediatek/phy-mtk-tphy.c b/drivers/phy/mediatek/phy-mtk-tphy.c
index 855a559a2..2e46f8928 100644
--- a/drivers/phy/mediatek/phy-mtk-tphy.c
+++ b/drivers/phy/mediatek/phy-mtk-tphy.c
@@ -115,6 +115,10 @@
 #define P2C_FORCE_AVALID	BIT(10)
 #define P2C_FORCE_SESSEND	BIT(12)
 #define P2C_FORCE_VBUSVALID	BIT(13)
+#define P2C_FORCE_BVALID	BIT(11)
+#define P2C_FORCE_IDPULLUP	BIT(8)
+#define P2C_RG_BVALID		BIT(3)
+#define P2C_RG_IDPULLUP		BIT(0)
 
 #define P2C_RG_VBUSVALID		BIT(5)
 #define P2C_RG_SESSEND			BIT(4)
@@ -888,7 +892,14 @@ static void u2_phy_instance_power_on(struct mtk_tphy *tphy,
 		mtk_phy_set_bits(com + U3P_U2PHYDTM0, P2C_RG_SUSPENDM | P2C_FORCE_SUSPENDM);
 	}
 
-	mtk_phy_set_bits(com + U3P_U2PHYDTM1, P2C_FORCE_AVALID | P2C_FORCE_VBUSVALID | P2C_FORCE_SESSEND);
+	/*
+	 * Mobile SoCs have no VBUS/session sensing on this path: force all
+	 * session signals, as the vendor driver does (device 0x3f2f, host
+	 * 0x3f2d). BVALID is needed for device sessions, IDPULLUP for IDDIG.
+	 */
+	mtk_phy_set_bits(com + U3P_U2PHYDTM1, P2C_RG_BVALID | P2C_RG_IDPULLUP);
+	mtk_phy_set_bits(com + U3P_U2PHYDTM1, P2C_FORCE_AVALID | P2C_FORCE_VBUSVALID |
+			 P2C_FORCE_SESSEND | P2C_FORCE_BVALID | P2C_FORCE_IDPULLUP);
 
 	dev_dbg(tphy->dev, "%s(%d)\n", __func__, index);
 }
@@ -903,7 +914,7 @@ static void u2_phy_instance_power_off(struct mtk_tphy *tphy,
 	/* OTG Disable */
 	mtk_phy_clear_bits(com + U3P_USBPHYACR6, PA6_RG_U2_OTG_VBUSCMP_EN);
 
-	mtk_phy_clear_bits(com + U3P_U2PHYDTM1, P2C_RG_VBUSVALID | P2C_RG_AVALID);
+	mtk_phy_clear_bits(com + U3P_U2PHYDTM1, P2C_RG_VBUSVALID | P2C_RG_AVALID | P2C_RG_BVALID);
 
 	mtk_phy_set_bits(com + U3P_U2PHYDTM1, P2C_RG_SESSEND);
 
