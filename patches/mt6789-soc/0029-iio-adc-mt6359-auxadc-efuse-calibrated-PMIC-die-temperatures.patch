From: Claude <noreply@anthropic.com>
Subject: [PATCH] iio: adc: mt6359-auxadc: efuse-calibrated MT6358/MT6366 die temperatures

0024 converted CHIP/VCORE/VPROC/VGPU_TEMP (and TSX/DCXO_TEMP) with an
invented linear formula, 25 + (750 - mV) / 4 degC. Replace it for
MT6358/MT6366 with the vendor conversion from the 5.10 BSP
(drivers/thermal/mediatek/pmic_temp.c, "mediatek,mt6366-pmic-temp":
mt6366_get_cali_data, pmic_get_temp_convert_params, pmic_raw_to_temp):

  slope2    = -(factor +/- o_slope)
  intercept = (-(o_vts * 1800 / 4096) * 1000 * 1000) / -(factor +/- 10 * o_slope)
              + degc_cali * 500
  T[mdegC]  = intercept + 1000000 * mV / slope2

with factor 1681 (chip) / 1863 (vcore, vproc, vgpu). o_vts, degc_cali,
o_slope(_sign), id and ADC_CALI_EN come from PMIC efuse words 0x40..0x4b
(vendor DT mt6366_thermal_efuse reg = <0x40 0x0c>), read once at probe via
the PMIC OTP software-read registers exactly like the vendor
drivers/nvmem/mt635x-efuse.c (mt6358-efuse, reg_v1). Mainline has no
MT6358 efuse nvmem provider, so the read is done here. Without calibration
(read failure or ADC_CALI_EN = 0) the vendor defaults are used:
o_vts = 1600, degc_cali = 50, o_slope = 0.

TSX_TEMP/DCXO_TEMP and other PMICs go back to upstream behaviour (mV).
---
--- a/drivers/iio/adc/mt6359-auxadc.c
+++ b/drivers/iio/adc/mt6359-auxadc.c
@@ -43,6 +43,28 @@
 #define MT6358_IMP0_IRQ_RDY		BIT(8)
 #define MT6358_IMP1_AUTOREPEAT_EN	BIT(15)
 
+/*
+ * MT6358/MT6366 PMIC OTP (efuse) software read interface, as used by the
+ * vendor 5.10 drivers/nvmem/mt635x-efuse.c ("mediatek,mt6358-efuse" uses its
+ * reg_v1 layout, control registers have SET/CLR at +2/+4).
+ */
+#define MT6358_TOP_CKPDN_CON0		0x10c
+#define MT6358_TOP_CKHWEN_CON0		0x12a
+#define MT6358_OTP_CON0			0x38a	/* row address (byte offset) */
+#define MT6358_OTP_CON8			0x39a	/* read trigger (toggle) */
+#define MT6358_OTP_CON11		0x3a0	/* SW read mode */
+#define MT6358_OTP_CON12		0x3a2	/* read data */
+#define MT6358_OTP_CON13		0x3a4	/* read busy */
+#define MT6358_CTRL_SET			0x2
+#define MT6358_CTRL_CLR			0x4
+#define MT6358_EFUSE_CK_PDN_HWEN	BIT(2)
+#define MT6358_EFUSE_CK_PDN		BIT(4)
+#define MT6358_OTP_RD_BUSY		BIT(0)
+/* Vendor DT: mt6366_thermal_efuse { reg = <0x40 0x0c>; } -> 6 words */
+#define MT6358_TEMP_EFUSE_OFFSET	0x40
+#define MT6358_TEMP_EFUSE_WORDS		6
+#define MT6358_NUM_TEMP_SENSORS		4
+
 #define MT6359_IMP0_CONV_EN		BIT(0)
 #define MT6359_IMP1_IRQ_RDY		BIT(15)
 
@@ -105,6 +127,7 @@
  * @chip_info:     PMIC specific chip info
  * @lock:          Mutex to serialize AUXADC reading vs configuration
  * @timed_out:     Signals whether the last read timed out
+ * @temp_cali:     Efuse-derived die temperature conversion (MT6358/MT6366)
  */
 struct mt6359_auxadc {
 	struct device *dev;
@@ -112,6 +135,11 @@
 	const struct mtk_pmic_auxadc_info *chip_info;
 	struct mutex lock;
 	bool timed_out;
+	struct {
+		bool valid;
+		int slope2[MT6358_NUM_TEMP_SENSORS];
+		int intercept[MT6358_NUM_TEMP_SENSORS];
+	} temp_cali;
 };
 
 /**
@@ -165,6 +193,7 @@
 	bool no_reset;
 	int (*read_imp)(struct mt6359_auxadc *adc_dev,
 			const struct iio_chan_spec *chan, int *vbat, int *ibat);
+	void (*init_temp_cali)(struct mt6359_auxadc *adc_dev);
 };
 
 #define MTK_PMIC_ADC_EXT_CHAN(_ch_idx, _req_idx, _req_bit, _rdy_idx, _rdy_bit,	\
@@ -560,6 +589,123 @@
 	.vref_mV = 1800,
 };
 
+static int mt6358_efuse_read(struct mt6359_auxadc *adc_dev, unsigned int offset,
+			     u16 *buf, unsigned int nwords)
+{
+	struct regmap *map = adc_dev->regmap;
+	unsigned int trig, val, i;
+	int ret;
+
+	ret = regmap_read(map, MT6358_OTP_CON8, &trig);
+	if (ret)
+		return ret;
+
+	/* Enable the efuse control engine clocks */
+	ret = regmap_write(map, MT6358_TOP_CKHWEN_CON0 + MT6358_CTRL_CLR,
+			   MT6358_EFUSE_CK_PDN_HWEN);
+	if (ret)
+		return ret;
+	ret = regmap_write(map, MT6358_TOP_CKPDN_CON0 + MT6358_CTRL_CLR,
+			   MT6358_EFUSE_CK_PDN);
+	if (ret)
+		goto out;
+	ret = regmap_write(map, MT6358_OTP_CON11, 1);
+	if (ret)
+		goto out;
+
+	for (i = 0; i < nwords; i++) {
+		ret = regmap_write(map, MT6358_OTP_CON0, offset + i * 2);
+		if (ret)
+			goto out;
+		trig = trig ? 0 : 1;
+		ret = regmap_write(map, MT6358_OTP_CON8, trig);
+		if (ret)
+			goto out;
+		udelay(50);
+		ret = regmap_read_poll_timeout(map, MT6358_OTP_CON13, val,
+					       !(val & MT6358_OTP_RD_BUSY),
+					       50, 30000);
+		if (ret)
+			goto out;
+		udelay(80);
+		ret = regmap_read(map, MT6358_OTP_CON12, &val);
+		if (ret)
+			goto out;
+		buf[i] = val;
+	}
+out:
+	regmap_write(map, MT6358_OTP_CON11, 0);
+	regmap_write(map, MT6358_TOP_CKHWEN_CON0 + MT6358_CTRL_SET,
+		     MT6358_EFUSE_CK_PDN_HWEN);
+	regmap_write(map, MT6358_TOP_CKPDN_CON0 + MT6358_CTRL_SET,
+		     MT6358_EFUSE_CK_PDN);
+	return ret;
+}
+
+/*
+ * Die temperature conversion for CHIP/VCORE/VPROC/VGPU_TEMP, equivalent to
+ * the vendor 5.10 drivers/thermal/mediatek/pmic_temp.c (compatible
+ * "mediatek,mt6366-pmic-temp": mt6366_get_cali_data() +
+ * pmic_get_temp_convert_params() + pmic_raw_to_temp()), with the same integer
+ * arithmetic. If the efuse cannot be read or ADC_CALI_EN is not set, the
+ * vendor defaults are kept: o_vts = 1600, degc_cali = 50, o_slope = 0.
+ */
+static void mt6358_init_temp_cali(struct mt6359_auxadc *adc_dev)
+{
+	/* chip_temp, vcore_temp, vproc_temp, vgpu_temp (vendor ts1..ts4) */
+	static const int cali_factor[MT6358_NUM_TEMP_SENSORS] = {
+		1681, 1863, 1863, 1863
+	};
+	int o_vts[MT6358_NUM_TEMP_SENSORS] = { 1600, 1600, 1600, 1600 };
+	int degc_cali = 50, o_slope = 0, o_slope_sign = 0;
+	const int pullup_mv = 1800;
+	u16 e[MT6358_TEMP_EFUSE_WORDS];
+	int i, ret;
+
+	ret = mt6358_efuse_read(adc_dev, MT6358_TEMP_EFUSE_OFFSET, e,
+				MT6358_TEMP_EFUSE_WORDS);
+	if (ret) {
+		dev_warn(adc_dev->dev,
+			 "efuse read failed (%d), using default temp calibration\n",
+			 ret);
+	} else if (e[0] & BIT(8)) {	/* ADC_CALI_EN */
+		o_vts[0] = e[1] & GENMASK(12, 0);
+		o_vts[1] = e[4] & GENMASK(12, 0);
+		o_vts[2] = e[5] & GENMASK(12, 0);
+		o_vts[3] = (e[3] & GENMASK(15, 5)) >> 5;
+		degc_cali = e[0] & GENMASK(5, 0);
+		o_slope_sign = (e[2] & BIT(8)) >> 8;
+		o_slope = e[2] & GENMASK(5, 0);
+		if (!(e[3] & BIT(4)))	/* id == 0 */
+			o_slope = 0;
+		if (degc_cali < 38 || degc_cali > 60)
+			degc_cali = 53;
+	}
+
+	for (i = 0; i < MT6358_NUM_TEMP_SENSORS; i++) {
+		int factor = cali_factor[i];
+		s64 vbe_t;
+		int div;
+
+		adc_dev->temp_cali.slope2[i] = o_slope_sign ?
+			-(factor - o_slope) : -(factor + o_slope);
+
+		/* vendor quirk kept as-is: intercept uses o_slope * 10 */
+		vbe_t = -(s64)(o_vts[i] * pullup_mv / 4096) * 1000;
+		div = o_slope_sign ? -(factor - o_slope * 10) :
+				     -(factor + o_slope * 10);
+		adc_dev->temp_cali.intercept[i] =
+			div_s64(vbe_t * 1000, div) + degc_cali * (1000 / 2);
+	}
+	adc_dev->temp_cali.valid = true;
+
+	dev_dbg(adc_dev->dev,
+		"temp cali: efuse %s cali_en=%d degc=%d o_slope=%d sign=%d o_vts=%d/%d/%d/%d\n",
+		ret ? "unreadable" : "ok", ret ? 0 : !!(e[0] & BIT(8)),
+		degc_cali, o_slope, o_slope_sign,
+		o_vts[0], o_vts[1], o_vts[2], o_vts[3]);
+}
+
 static const struct mtk_pmic_auxadc_info mt6358_chip_info = {
 	.model_name = "MT6358",
 	.channels = mt6358_auxadc_channels,
@@ -568,6 +714,7 @@
 	.regs = mt6358_auxadc_regs,
 	.imp_adc_num = MT6358_IMP_ADC_NUM,
 	.read_imp = mt6358_read_imp,
+	.init_temp_cali = mt6358_init_temp_cali,
 	.vref_mV = 1800,
 };
 
@@ -827,11 +974,21 @@
 		case PMIC_AUXADC_CHAN_VCORE_TEMP:
 		case PMIC_AUXADC_CHAN_VPROC_TEMP:
 		case PMIC_AUXADC_CHAN_VGPU_TEMP:
-		case PMIC_AUXADC_CHAN_TSX_TEMP:
-		case PMIC_AUXADC_CHAN_DCXO_TEMP:
 			v_mv = div_s64((s64)(*val) * desc->r_ratio.numerator * cinfo->vref_mV,
 				       (s64)desc->r_ratio.denominator << chan->scan_type.realbits);
-			*val = 25000 + ((750 - v_mv) * 1000) / 4;
+			if (!adc_dev->temp_cali.valid) {
+				/* No calibration for this PMIC: report mV */
+				*val = v_mv;
+				break;
+			}
+			{
+				int i = chan->scan_index - PMIC_AUXADC_CHAN_CHIP_TEMP;
+
+				/* millidegrees Celsius */
+				*val = adc_dev->temp_cali.intercept[i] +
+				       div_s64(1000000LL * v_mv,
+					       adc_dev->temp_cali.slope2[i]);
+			}
 			break;
 		case PMIC_AUXADC_CHAN_BAT_TEMP:
 			/*
@@ -903,6 +1060,9 @@
 
 	mt6359_auxadc_reset(adc_dev);
 
+	if (chip_info->init_temp_cali)
+		chip_info->init_temp_cali(adc_dev);
+
 	indio_dev->name = adc_dev->chip_info->model_name;
 	indio_dev->info = &mt6359_auxadc_iio_info;
 	indio_dev->modes = INDIO_DIRECT_MODE;
