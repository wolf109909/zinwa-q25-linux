From 4310018d02b60648c1cc19192e89c2a7bcb26c36 Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <me@adomerle.pw>
Date: Sun, 24 Aug 2025 09:43:47 +0400
Subject: [PATCH 06/23] interconnect: mediatek: Add MT6789 EMI Interconnect

Signed-off-by: Arseniy Velikanov <me@adomerle.pw>
---
 drivers/interconnect/mediatek/Kconfig         |   7 +
 drivers/interconnect/mediatek/Makefile        |   1 +
 drivers/interconnect/mediatek/mt6789.c        | 329 ++++++++++++++++++
 .../interconnect/mediatek,mt6789.h            |  43 +++
 4 files changed, 380 insertions(+)
 create mode 100644 drivers/interconnect/mediatek/mt6789.c
 create mode 100644 include/dt-bindings/interconnect/mediatek,mt6789.h

diff --git a/drivers/interconnect/mediatek/Kconfig b/drivers/interconnect/mediatek/Kconfig
index 9fd3f2170..27929d283 100644
--- a/drivers/interconnect/mediatek/Kconfig
+++ b/drivers/interconnect/mediatek/Kconfig
@@ -14,6 +14,13 @@ config INTERCONNECT_MTK_DVFSRC_EMI
 	  interconnect on SoCs equipped with the integrated Dynamic
 	  Voltage Frequency Scaling Resource Collector (DVFSRC) MCU
 
+config INTERCONNECT_MTK_MT6789
+	tristate "MediaTek MT6789 interconnect driver"
+	depends on INTERCONNECT_MTK_DVFSRC_EMI
+	help
+	  This is a driver for the MediaTek bus interconnect on MT6789-based
+	  platforms.
+
 config INTERCONNECT_MTK_MT8183
 	tristate "MediaTek MT8183 interconnect driver"
 	depends on INTERCONNECT_MTK_DVFSRC_EMI
diff --git a/drivers/interconnect/mediatek/Makefile b/drivers/interconnect/mediatek/Makefile
index 6bd656668..974c31b86 100644
--- a/drivers/interconnect/mediatek/Makefile
+++ b/drivers/interconnect/mediatek/Makefile
@@ -1,6 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0
 
 obj-$(CONFIG_INTERCONNECT_MTK_DVFSRC_EMI) += icc-emi.o
+obj-$(CONFIG_INTERCONNECT_MTK_MT6789) += mt6789.o
 obj-$(CONFIG_INTERCONNECT_MTK_MT8183) += mt8183.o
 obj-$(CONFIG_INTERCONNECT_MTK_MT8195) += mt8195.o
 obj-$(CONFIG_INTERCONNECT_MTK_MT8195) += mt8196.o
