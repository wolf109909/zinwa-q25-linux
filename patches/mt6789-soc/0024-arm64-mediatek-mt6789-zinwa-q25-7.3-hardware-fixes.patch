+			*val = 25000 + ((850 - v_mv) * 1000) / 18;
+			break;
+		default:
+			*val = div_s64((s64)(*val) * desc->r_ratio.numerator * cinfo->vref_mV,
+				       (s64)desc->r_ratio.denominator << chan->scan_type.realbits);
