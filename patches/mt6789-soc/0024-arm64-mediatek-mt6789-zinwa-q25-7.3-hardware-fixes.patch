+		upm6722,bus-ovp-threshold = <12000>;
+		upm6722,bus-ocp-threshold = <5100>;
+		upm6722,bus-ucp-threshold = <250>;
+		upm6722,bus-rcp-threshold = <300>;
+		upm6722,vac1-ovp-threshold = <18000>;
+		upm6722,vac2-ovp-threshold = <18000>;
+		upm6722,vout-ovp-threshold = <5000>;
+		upm6722,tdie-flt-threshold = <140>;
