@@ -1,14 +1,61 @@
 // SPDX-License-Identifier: GPL-2.0
 
+#include <linux/bits.h>
 #include <linux/clk-provider.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/regmap.h>
 
 #include "clk-mtk.h"
 #include "clk-gate.h"
 
 #include <dt-bindings/clock/mediatek,mt6789-clk.h>
 
+struct mtk_clk_gate_priv {
+	struct clk_hw	hw;
+	struct regmap	*regmap;
+	struct regmap	*regmap_hwv;
+	const struct mtk_gate *gate;
+};
+
+static int mt6789_mfgcfg_cg_enable(struct clk_hw *hw)
+{
+	struct mtk_clk_gate_priv *cg = container_of(hw, struct mtk_clk_gate_priv, hw);
+	int ret;
+
+	ret = mtk_clk_gate_ops_setclr.enable(hw);
+	if (ret)
+		return ret;
+
+	/*
+	 * Configure MT6789 MFG_TOP_CONFIG external CGs and AXI bridge
+	 * (matches __gpufreq_external_cg_control in gpufreq_mt6789.c).
+	 */
+	regmap_set_bits(cg->regmap, 0x20, GENMASK(25, 22));
+	regmap_update_bits(cg->regmap, 0xb0, GENMASK(10, 8) | BIT(19), BIT(19));
+	regmap_set_bits(cg->regmap, 0xb4, BIT(4));
+	regmap_set_bits(cg->regmap, 0x24, BIT(0));
+	regmap_set_bits(cg->regmap, 0xf60, BIT(0));
+
+	return 0;
+}
+
+static void mt6789_mfgcfg_cg_disable(struct clk_hw *hw)
+{
+	mtk_clk_gate_ops_setclr.disable(hw);
+}
+
+static int mt6789_mfgcfg_cg_is_enabled(struct clk_hw *hw)
+{
+	return mtk_clk_gate_ops_setclr.is_enabled(hw);
+}
+
+static const struct clk_ops mt6789_mfgcfg_clk_gate_ops = {
+	.is_enabled	= mt6789_mfgcfg_cg_is_enabled,
+	.enable		= mt6789_mfgcfg_cg_enable,
+	.disable	= mt6789_mfgcfg_cg_disable,
+};
+
