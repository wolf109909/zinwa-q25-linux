@@ -54,6 +54,42 @@
 #include <asm/efi.h>
 #include <asm/xen/hypervisor.h>
 #include <asm/mmu_context.h>
+#include <asm/fixmap.h>
+#include <asm/io.h>
+
+static bool q25_pmsg_ready;
+
+void q25_pmsg_write(const char *s, unsigned int len)
+{
+	u32 *hdr;
+	char *data;
+	u32 pos, i;
+
+	if (!q25_pmsg_ready || !s || !len)
+		return;
+
+	hdr = (u32 *)__fix_to_virt(FIX_Q25_PMSG_BEGIN);
+	data = (char *)(hdr + 3);
+
+	if (READ_ONCE(hdr[0]) != 0x43474244U) {
+		WRITE_ONCE(hdr[0], 0x43474244U);
+		WRITE_ONCE(hdr[1], 0);
+		WRITE_ONCE(hdr[2], 0);
+	}
+
+	pos = READ_ONCE(hdr[2]);
+	if (pos >= 65000U)
+		return;
+
+	for (i = 0; i < len && pos < 65500U; i++)
+		WRITE_ONCE(data[pos++], s[i]);
+	if (pos < 65520U)
+		WRITE_ONCE(data[pos++], '\n');
+
+	WRITE_ONCE(hdr[2], pos);
+	dsb(sy);
+}
+EXPORT_SYMBOL(q25_pmsg_write);
 
