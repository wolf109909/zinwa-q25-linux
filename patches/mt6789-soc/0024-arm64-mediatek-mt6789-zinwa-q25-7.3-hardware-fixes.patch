 	early_ioremap_init();
+	for (int i = 0; i < 16; i++)
+		__set_fixmap(FIX_Q25_PMSG_BEGIN - i, 0x48160000 + i * PAGE_SIZE,
+			     __pgprot(PROT_NORMAL_NC));
+	q25_pmsg_ready = true;
+	{
+		void __iomem *wdt;
+		__set_fixmap(FIX_TEXT_POKE0, 0x10007000, FIXMAP_PAGE_IO);
+		wdt = (void __iomem *)__fix_to_virt(FIX_TEXT_POKE0);
+		writel_relaxed(0x7808, wdt + 0x04);
+		writel_relaxed(0x1971, wdt + 0x08);
+		writel_relaxed(0x22000005, wdt + 0x00);
+		dsb(sy);
+	}
 
 	setup_machine_fdt(__fdt_pointer);
 
