+
+	/* Zinwa Q25 RGB Notification LEDs */
+	leds {
+		compatible = "gpio-leds";
+
+		led-red {
+			label = "red";
+			gpios = <&pio 46 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+
+		led-green {
+			label = "green";
+			gpios = <&pio 48 GPIO_ACTIVE_HIGH>;
+			default-state = "keep";
+		};
+
+		led-blue {
+			label = "blue";
+			gpios = <&pio 49 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+
+	/* Volume Down GPIO key (KPD_KCOL0 on GPIO 43) */
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		key-volumedown {
+			label = "Volume Down";
+			gpios = <&pio 43 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEDOWN>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+	};
+
+	/* Display PWM Backlight */
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&disp_pwm0 0 500000>;
+		brightness-levels = <0 1023>;
+		num-interpolated-steps = <1023>;
+		default-brightness-level = <400>;
+	};
+
+	/* Zinwa Q25 Keyboard & Optical Trackpad Power Sequencing / Firmware Control */
+	pdrv_bbqX0kbd: pdrv_bbqX0kbd {
+		compatible = "wallComputer,pdrv_bbqX0kbd";
+		irq-gpio = <&pio 12 GPIO_ACTIVE_HIGH>;
+		int-gpios = <&pio 12 GPIO_ACTIVE_HIGH>;
+		power-vdd-gpios = <&pio 159 GPIO_ACTIVE_HIGH>;
+		power-1v8-gpios = <&pio 157 GPIO_ACTIVE_HIGH>;
+		power-2v8-gpios = <&pio 158 GPIO_ACTIVE_HIGH>;
+		firmware-download-gpios = <&pio 47 GPIO_ACTIVE_HIGH>;
+	};
 };
 
