From eb01a554cc5a0e95fb1ba285bd84da38e85614b6 Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <me@adomerle.pw>
Date: Sun, 24 Aug 2025 09:42:19 +0400
Subject: [PATCH 05/23] regulator: mtk-dvfsrc: Add support for MT6789

Signed-off-by: Arseniy Velikanov <me@adomerle.pw>
---
 drivers/regulator/mtk-dvfsrc-regulator.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/regulator/mtk-dvfsrc-regulator.c b/drivers/regulator/mtk-dvfsrc-regulator.c
index c0c9a6751..fffc46816 100644
--- a/drivers/regulator/mtk-dvfsrc-regulator.c
+++ b/drivers/regulator/mtk-dvfsrc-regulator.c
@@ -100,6 +100,23 @@ static const struct regulator_ops dvfsrc_vcore_ops = {
 	.set_voltage_sel = dvfsrc_set_voltage_sel,
 };
 
+static const unsigned int mt6789_voltages[] = {
+	550000,
+	600000,
+	650000,
+	725000,
+};
+
+static const struct regulator_desc mt6789_regulators[] = {
+	MTK_DVFSRC_VREG("dvfsrc-vcore", VCORE, mt6789_voltages),
+	MTK_DVFSRC_VREG("dvfsrc-vscp", VSCP, mt6789_voltages),
+};
+
+static const struct dvfsrc_regulator_pdata mt6789_data = {
+	.descs = mt6789_regulators,
+	.size = ARRAY_SIZE(mt6789_regulators),
+};
+
 static const unsigned int mt6873_voltages[] = {
 	575000,
 	600000,
@@ -208,6 +225,7 @@ static int dvfsrc_vcore_regulator_probe(struct platform_device *pdev)
 }
 
 static const struct of_device_id mtk_dvfsrc_regulator_match[] = {
+	{ .compatible = "mediatek,mt6789-dvfsrc-regulator", .data = &mt6789_data },
 	{ .compatible = "mediatek,mt6873-dvfsrc-regulator", .data = &mt6873_data },
 	{ .compatible = "mediatek,mt6893-dvfsrc-regulator", .data = &mt6893_data },
 	{ .compatible = "mediatek,mt8183-dvfsrc-regulator", .data = &mt8183_data },
-- 
2.55.0

