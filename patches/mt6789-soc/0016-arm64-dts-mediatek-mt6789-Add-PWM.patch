From 351cebbecdb3550743c0c38173d99774133b1382 Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <me@adomerle.pw>
Date: Mon, 18 Aug 2025 15:12:22 +0400
Subject: [PATCH 16/23] arm64: dts: mediatek: mt6789: Add PWM

Signed-off-by: Arseniy Velikanov <me@adomerle.pw>
---
 arch/arm64/boot/dts/mediatek/mt6789.dtsi | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6789.dtsi b/arch/arm64/boot/dts/mediatek/mt6789.dtsi
index 39c7ae2d4..2a9cd80ba 100644
--- a/arch/arm64/boot/dts/mediatek/mt6789.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6789.dtsi
@@ -1148,6 +1148,20 @@ pio: pinctrl@10005000 {
 			#interrupt-cells = <2>;
 		};
 
+		pwm0: pwm@10048000 {
+			compatible = "mediatek,mt6789-pwm";
+			reg = <0 0x10048000 0 0x1000>;
+			interrupts = <GIC_SPI 242 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
+			#pwm-cells = <2>;
+			clocks = <&topckgen CLK_TOP_PWM_SEL>,
+				 <&infracfg_ao CLK_IFRAO_PWM>,
+				 <&infracfg_ao CLK_IFRAO_PWM1>,
+				 <&infracfg_ao CLK_IFRAO_PWM2>,
+				 <&infracfg_ao CLK_IFRAO_PWM3>,
+				 <&infracfg_ao CLK_IFRAO_PWM4>;
+			clock-names = "top", "main", "pwm1", "pwm2", "pwm3", "pwm4";
+		};
+
 		mmc0: mmc@11230000 {
 			compatible = "mediatek,mt6789-mmc",
 			             "mediatek,mt8183-mmc";
@@ -1225,9 +1239,9 @@ ufs: ufs@11270000 {
 
 			mediatek,ufs-disable-mcq;
 			mediatek,ufs-broken-vcc;
-        };
+		};
 
-		pwm0: pwm@1100e000 {
+		disp_pwm0: pwm@1100e000 {
 			compatible = "mediatek,mt6789-disp-pwm";
 			reg = <0 0x1100e000 0 0x1000>;
 			interrupts = <GIC_SPI 203 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
-- 
2.55.0

