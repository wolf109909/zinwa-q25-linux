From c3e9cf514b69174766c2619ca1789aa30aeca863 Mon Sep 17 00:00:00 2001
From: Alicja Michalska <ellyqw@mainlining.org>
Date: Wed, 15 Apr 2026 04:57:09 +0200
Subject: [PATCH 22/23] boot/dts/mtk: Correct MT6789 devicetree, add
 motorola-vicky

Disable larbs for now as we don't have working DSI, add missing ulposc
clock and DTS for Motorola Moto G72 (vicky) with MT6789 SoC.

Signed-off-by: Alicja Michalska <ellyqw@mainlining.org>
---
 arch/arm64/boot/dts/mediatek/Makefile         |   1 +
 .../dts/mediatek/mt6789-motorola-vicky.dts    | 815 ++++++++++++++++++
 arch/arm64/boot/dts/mediatek/mt6789.dtsi      |  37 +-
 .../dt-bindings/power/mediatek,mt6789-power.h |  20 +
 4 files changed, 871 insertions(+), 2 deletions(-)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6789-motorola-vicky.dts
 create mode 100644 include/dt-bindings/power/mediatek,mt6789-power.h

diff --git a/arch/arm64/boot/dts/mediatek/Makefile b/arch/arm64/boot/dts/mediatek/Makefile
index a86fb313b..122bc992e 100644
--- a/arch/arm64/boot/dts/mediatek/Makefile
+++ b/arch/arm64/boot/dts/mediatek/Makefile
@@ -2,6 +2,7 @@
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt2712-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6755-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6779-evb.dtb
+dtb-$(CONFIG_ARCH_MEDIATEK) += mt6789-motorola-vicky.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-sony-xperia-m5.dtb
