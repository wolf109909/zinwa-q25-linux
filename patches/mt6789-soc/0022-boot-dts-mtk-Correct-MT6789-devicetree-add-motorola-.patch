+
+	reg_vsys: regulator-vsys {
+		compatible = "regulator-fixed";
+		regulator-name = "vsys";
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	reg_avdd: regulator-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_avdd";
+		gpio = <&pio 12 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	reg_vio: regulator-vio {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_vio";
+		gpio = <&pio 46 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
