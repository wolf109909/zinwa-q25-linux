+		compatible = "regulator-fixed";
+		regulator-name = "vreg_dvdd";
+		gpio = <&pio 154 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
