+		compatible = "regulator-fixed";
+		regulator-name = "vreg_te";
+		gpio = <&pio 83 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
