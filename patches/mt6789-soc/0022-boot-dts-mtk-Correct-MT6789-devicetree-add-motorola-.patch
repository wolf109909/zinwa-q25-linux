diff --git a/arch/arm64/boot/dts/mediatek/mt6789-motorola-vicky.dts b/arch/arm64/boot/dts/mediatek/mt6789-motorola-vicky.dts
new file mode 100644
index 000000000..697ac0fb9
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6789-motorola-vicky.dts
@@ -0,0 +1,815 @@
+// SPDX-License-Identifier: GPL-2.0
+
+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/regulator/mediatek,mt6397-regulator.h>
+#include <dt-bindings/pinctrl/mediatek,mt6789-pinfunc.h>
