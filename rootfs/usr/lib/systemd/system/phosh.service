[Unit]
Description=Phosh mobile shell
Documentation=https://gitlab.gnome.org/World/Phosh/phosh
# Like a display manager: one autologin graphical session on tty7
After=systemd-user-sessions.service systemd-logind.service q25-hardware.service
Wants=dbus.socket systemd-logind.service
Conflicts=getty@tty7.service
OnFailure=getty@tty1.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=alarm
WorkingDirectory=~
PAMName=phosh
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_SESSION_DESKTOP=phosh XDG_CURRENT_DESKTOP=Phosh:GNOME
ExecStartPre=/usr/bin/chvt 7
ExecStart=/usr/bin/phosh-session
Restart=always
RestartSec=2

[Install]
Alias=display-manager.service
WantedBy=graphical.target
