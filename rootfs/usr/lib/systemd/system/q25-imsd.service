[Unit]
Description=Q25 IMS client (SMS over IP)
Documentation=file:///usr/lib/q25-imsd/README.md
After=ModemManager.service
BindsTo=ModemManager.service
PartOf=ModemManager.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/lib/q25-imsd/q25-imsd.py run
Restart=always
RestartSec=5
# needs NET_ADMIN (xfrm, routes) and the root-only ModemManager bridge socket
User=root
UMask=0077
StateDirectory=q25-imsd
StateDirectoryMode=0700
# SIGTERM deregisters from the IMS core (bounded to 3 s) before the SAs go away
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
