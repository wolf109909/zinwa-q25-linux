[Unit]
Description=Q25 LTE connection manager
Requires=q25-ccci@ccci_mdinit.service
After=q25-ccci@ccci_mdinit.service systemd-resolved.service
Wants=systemd-resolved.service

[Service]
Type=simple
ExecStart=/usr/lib/q25/q25-modemd
Restart=always
RestartSec=5
StateDirectory=q25

[Install]
WantedBy=multi-user.target
