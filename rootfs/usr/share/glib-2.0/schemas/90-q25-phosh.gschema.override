# Defaults only: users can change these in Settings / Mobile Settings.
# Desktop-qualified sections take precedence over Phosh's packaged overrides.
[sm.puri.phosh:Phosh]
favorites=['kitty.desktop', 'firefox.desktop', 'org.gnome.Settings.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Calls.desktop', 'sm.puri.Chatty.desktop', 'org.gnome.Contacts.desktop', 'org.gnome.clocks.desktop', 'mobi.phosh.MobileSettings.desktop']
# Expose the full installed app ecosystem, including desktop apps like Firefox.
app-filter-mode=[]
enable-suspend=false

[sm.puri.phosh.lockscreen:Phosh]
require-unlock=true

[org.gnome.desktop.a11y.applications:Phosh]
# Keep the OSK available manually; Stevia suppresses it with a hardware keyboard.
screen-keyboard-enabled=true

[mobi.phosh.osk:Phosh]
ignore-hw-keyboards=false

[org.gnome.desktop.session:Phosh]
idle-delay=120

[org.gnome.desktop.screensaver:Phosh]
lock-enabled=true
lock-delay=0

[org.gnome.desktop.interface:Phosh]
color-scheme='prefer-dark'
font-name='Noto Sans 10'
monospace-font-name='JetBrainsMono Nerd Font Mono 10'
icon-theme='Adwaita'
cursor-theme='Adwaita'

[org.gnome.settings-daemon.plugins.power:Phosh]
idle-dim=true
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
sleep-inactive-ac-timeout=0
sleep-inactive-battery-timeout=0
# Phosh owns short-press blank/lock and the long-press power menu.
power-button-action='nothing'
