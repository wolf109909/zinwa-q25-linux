# Plasma 6 profile schema. Suspend remains disabled until platform resume works.
# Action 64 = screen off, action 16 = logout/power menu, action 0 = do nothing.
[AC][SuspendAndShutdown]
AutoSuspendAction=0
PowerButtonAction=64
PowerDownAction=16
LidAction=0

[AC][Display]
DimDisplayWhenIdle=true
DimDisplayIdleTimeoutSec=60
TurnOffDisplayWhenIdle=true
TurnOffDisplayIdleTimeoutSec=120
TurnOffDisplayIdleTimeoutWhenLockedSec=30
LockBeforeTurnOffDisplay=true

[Battery][SuspendAndShutdown]
AutoSuspendAction=0
PowerButtonAction=64
PowerDownAction=16
LidAction=0

[Battery][Display]
DimDisplayWhenIdle=true
DimDisplayIdleTimeoutSec=60
TurnOffDisplayWhenIdle=true
TurnOffDisplayIdleTimeoutSec=120
TurnOffDisplayIdleTimeoutWhenLockedSec=30
LockBeforeTurnOffDisplay=true

[LowBattery][SuspendAndShutdown]
AutoSuspendAction=0
PowerButtonAction=64
PowerDownAction=16
LidAction=0

[LowBattery][Display]
DimDisplayWhenIdle=true
DimDisplayIdleTimeoutSec=30
TurnOffDisplayWhenIdle=true
TurnOffDisplayIdleTimeoutSec=60
TurnOffDisplayIdleTimeoutWhenLockedSec=15
LockBeforeTurnOffDisplay=true

[BatteryManagement]
# Keep low-battery warnings, but never attempt unvalidated system sleep.
BatteryCriticalAction=0
