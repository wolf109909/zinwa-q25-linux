# Q25 root only: /home, /root, /srv, caches, logs and snapshots are separate.
SUBVOLUME="/"
FSTYPE="btrfs"
# Avoid qgroup accounting overhead on the phone. Limits below are counts, not GB.
QGROUP=""
SPACE_LIMIT="0.2"
FREE_LIMIT="0.1"
UNIQUE_NUMBERS="yes"
ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="no"
BACKGROUND_COMPARISON="no"
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="3600"
NUMBER_LIMIT="8"
NUMBER_LIMIT_IMPORTANT="4"
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="3600"
TIMELINE_LIMIT_HOURLY="6"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="4"
TIMELINE_LIMIT_MONTHLY="1"
TIMELINE_LIMIT_QUARTERLY="0"
TIMELINE_LIMIT_YEARLY="0"
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="3600"
