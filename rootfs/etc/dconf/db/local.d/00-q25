# Zinwa Q25 defaults (users can change all of these)
[sm/puri/phosh]
favorites=['org.gnome.Console.desktop', 'firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Settings.desktop']

[org/gnome/desktop/a11y/applications]
# hardware QWERTY keyboard: no on-screen keyboard unless switched on
screen-keyboard-enabled=false

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
font-name='Noto Sans 11'
monospace-font-name='JetBrainsMono Nerd Font Mono 10'
document-font-name='Noto Sans 11'
show-battery-percentage=true

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true

[org/gnome/desktop/session]
idle-delay=uint32 120

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
